<turbo-frame id="maintainer-content">
    <turbo-frame id="admission-wizard-content">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
            {{ include('admission/wizard/_timeline.html.twig', { current_step: 2 }) }}
            <h4 class="mb-3">Paso 2 de 3: Resguardo Financiero</h4>

            <div class="alert alert-success" role="alert">
                <strong><i class="bx bx-info-circle"></i> Si selecciona un medio de pago de garantía, debe ingresar el monto y completar sus datos.</strong>
            </div>

            {% for message in app.flashes('danger') %}
                <div class="alert alert-danger" role="alert">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('warning') %}
                <div class="alert alert-warning" role="alert">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success" role="alert">{{ message }}</div>
            {% endfor %}

            <form method="post"
                  action="{{ path('app_admission_wizard_step3') }}"
                  data-turbo="false"
                  data-turbo-frame="_top">
                <input type="hidden" name="_token" value="{{ csrf_token('admission_step3_financial') }}">

                {{ include('revenue/payment/_batch.html.twig', {
                    payment_methods: payment_methods,
                    initial_rows: initial_rows
                }) }}

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a href="{{ path('app_admission_wizard_step2') }}" class="btn btn-outline-secondary">
                        <i class="bx bx-chevron-left"></i> Volver
                    </a>
                    <button type="submit" class="btn btn-success">
                        Continuar <i class="bx bx-chevron-right"></i>
                    </button>
                </div>
            </form>
            </div>
        </div>
    </turbo-frame>
</turbo-frame>
