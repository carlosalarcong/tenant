<turbo-frame id="maintainer-content">
    <turbo-frame id="admission-wizard-content">
        <div class="admission-step2 mt-4">

            {{ include('admission/wizard/_timeline.html.twig', { current_step: 2 }) }}

            <div class="mb-4">
                <h2 class="admission-step-title">Paso 2 de 3: Resguardo Financiero</h2>
                <p class="admission-step-subtitle">Seleccione los medios de pago de garantía e ingrese los montos correspondientes.</p>
            </div>

            {% for message in app.flashes('danger') %}
                <div class="alert alert-danger alert-dismissible" role="alert">
                    <i class="bx bx-error-circle me-1"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            {% endfor %}
            {% for message in app.flashes('warning') %}
                <div class="alert alert-warning alert-dismissible" role="alert">
                    <i class="bx bx-error me-1"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            {% endfor %}

            <form method="post"
                  action="{{ path('app_admission_wizard_step3') }}"
                  data-turbo="false"
                  data-turbo-frame="_top">
                <input type="hidden" name="_token" value="{{ csrf_token('admission_step3_financial') }}">

                {{ include('revenue/payment/_batch.html.twig', {
                    payment_methods: payment_methods,
                    initial_rows: initial_rows
                }) }}

                <div class="admission-nav-bar">
                    <a href="{{ path('app_admission_wizard_step2') }}"
                       class="btn btn-outline-secondary admission-btn-back">
                        <i class="bx bx-chevron-left"></i> Volver
                    </a>
                    <button type="submit"
                            class="btn btn-primary admission-btn-next admission-btn-continue"
                            data-payment-continue-btn>
                        Continuar <i class="bx bx-chevron-right"></i>
                    </button>
                </div>
            </form>

        </div>
    </turbo-frame>
</turbo-frame>
