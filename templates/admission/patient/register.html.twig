{% extends 'app_layout.html.twig' %}

{% block title %}{{ page_title }} - Sistema{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('libs/flatpickr/flatpickr.min.css') }}">
{% endblock %}

{% block content %}
    <div class="container-fluid px-4 py-4">
        <h1>{{ page_title }}</h1>
        {% if foreign_mode|default(false) %}
            <div class="alert alert-info mt-3 mb-4" role="alert">
                Registro extranjero: puedes continuar sin RUT/documento. El sistema generará un identificador `EXT-...` si queda vacío.
            </div>
        {% endif %}

        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header bg-success text-white">
                Datos del Paciente
            </div>
            <div class="card-body">
                {{ form_start(form, {
                    action: path('app_admission_patient_register'),
                    attr: {
                        'data-controller': 'admission--email-validator',
                        'data-action': 'submit->admission--email-validator#validateOnSubmit'
                    }
                }) }}
                    {{ form_widget(form.admission_type) }}
                    {% if form_errors(form) %}
                        <div class="alert alert-danger">{{ form_errors(form) }}</div>
                    {% endif %}
                    <div class="row g-3">
                        <div class="col-md-4">
                            {{ form_label(form.identification_type, foreign_mode|default(false) ? 'Tipo Documento' : 'Tipo Documento *', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.identification_type, { attr: { class: 'form-select', id: 'identification_type', required: (not foreign_mode|default(false)) } }) }}
                            {{ form_errors(form.identification_type) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.identification, foreign_mode|default(false) ? 'Identificación (opcional)' : 'Identificación *', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.identification, { attr: { class: 'form-control', id: 'identification', required: (not foreign_mode|default(false)) } }) }}
                            {{ form_errors(form.identification) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.birth_date, 'Fecha Nacimiento *', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.birth_date, { attr: { class: 'form-control', id: 'birth_date', required: true, autocomplete: 'off', placeholder: 'dd-mm-aaaa', 'data-controller': 'admission--birth-date-picker' } }) }}
                            {{ form_errors(form.birth_date) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.name, 'Nombre *', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.name, { attr: { class: 'form-control', id: 'name', required: true } }) }}
                            {{ form_errors(form.name) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.last_name, 'Apellido Paterno *', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.last_name, { attr: { class: 'form-control', id: 'last_name', required: true } }) }}
                            {{ form_errors(form.last_name) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.middle_name, 'Apellido Materno', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.middle_name, { attr: { class: 'form-control', id: 'middle_name' } }) }}
                            {{ form_errors(form.middle_name) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.gender, 'Sexo', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.gender, { attr: { class: 'form-select', id: 'gender' } }) }}
                            {{ form_errors(form.gender) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.country, 'Nacionalidad', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.country, { attr: { class: 'form-select', id: 'country' } }) }}
                            {{ form_errors(form.country) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.marital_status, 'Estado civil', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.marital_status, { attr: { class: 'form-select', id: 'marital_status' } }) }}
                            {{ form_errors(form.marital_status) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.mobile_phone, 'Teléfono Móvil *', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.mobile_phone, { attr: { class: 'form-control', id: 'mobile_phone', required: true } }) }}
                            {{ form_errors(form.mobile_phone) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.home_phone, 'Teléfono fijo', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.home_phone, { attr: { class: 'form-control', id: 'home_phone' } }) }}
                            {{ form_errors(form.home_phone) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.work_phone, 'Teléfono trabajo', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.work_phone, { attr: { class: 'form-control', id: 'work_phone' } }) }}
                            {{ form_errors(form.work_phone) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.email, 'Email', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.email, { attr: { class: 'form-control', id: 'email', type: 'email', 'data-admission--email-validator-target': 'email', 'data-action': 'input->admission--email-validator#validatePrimary blur->admission--email-validator#validatePrimary' } }) }}
                            {{ form_errors(form.email) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.secondary_email, 'Email secundario', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.secondary_email, { attr: { class: 'form-control', id: 'secondary_email', type: 'email', 'data-admission--email-validator-target': 'secondaryEmail', 'data-action': 'input->admission--email-validator#validateSecondary blur->admission--email-validator#validateSecondary' } }) }}
                            {{ form_errors(form.secondary_email) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.social_name, 'Nombre social', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.social_name, { attr: { class: 'form-control', id: 'social_name' } }) }}
                            {{ form_errors(form.social_name) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.number_of_children, 'N° hijos', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.number_of_children, { attr: { class: 'form-control', id: 'number_of_children', min: 0, type: 'number' } }) }}
                            {{ form_errors(form.number_of_children) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.occupation, 'Ocupación', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.occupation, { attr: { class: 'form-select', id: 'occupation' } }) }}
                            {{ form_errors(form.occupation) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.religion, 'Religión', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.religion, { attr: { class: 'form-select', id: 'religion' } }) }}
                            {{ form_errors(form.religion) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.education_level, 'Nivel instrucción', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.education_level, { attr: { class: 'form-select', id: 'education_level' } }) }}
                            {{ form_errors(form.education_level) }}
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a href="{{ path('app_admission_hospitalization_index') }}"
                           class="btn btn-outline-secondary"
                           data-turbo-frame="maintainer-content">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-success">Guardar y continuar</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
