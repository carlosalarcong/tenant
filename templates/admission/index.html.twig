{% extends 'app_layout.html.twig' %}

{% block title %}{{ page_title }} - Sistema{% endblock %}

{% block content %}
    <div class="container-fluid px-4 py-4">
        <h1>{{ page_title }}</h1>

        <div class="alert alert-info mt-3 mb-4" role="alert">
            Para comenzar con la admisión, primero busca al paciente por documento o nombre.
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white">
                Búsqueda de Paciente
            </div>
            <div class="card-body">
                {{ form_start(search_form, {
                    method: 'GET',
                    action: path(search_action_route|default('app_admission_hospitalization_index')),
                    attr: {
                        'data-controller': 'admission--rut-validator',
                        'data-admission--rut-validator-rut-type-id-value': rut_type_id|default(0),
                        'data-admission--rut-validator-target': 'form',
                        'data-action': 'submit->admission--rut-validator#validateOnSubmit'
                    }
                }) }}
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            {{ form_label(search_form.identification_type, 'Tipo documento', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(search_form.identification_type, { attr: {
                                class: 'form-select',
                                id: 'identification_type',
                                'data-admission--rut-validator-target': 'typeSelect',
                                'data-action': 'change->admission--rut-validator#onTypeChange'
                            } }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(search_form.q, 'RUT / Documento / Nombre', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(search_form.q, {
                                attr: {
                                    class: 'form-control',
                                    id: 'q',
                                    placeholder: 'Ejemplo: 12345678-9 o Carlos Alarcón',
                                    required: true,
                                    'data-admission--rut-validator-target': 'queryInput',
                                    'data-action': 'input->admission--rut-validator#onQueryInput'
                                }
                            }) }}
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">
                                Buscar
                            </button>
                        </div>
                    </div>
                    <div class="text-danger small mt-2 d-none"
                         data-admission--rut-validator-target="errorMessage"></div>
                {{ form_end(search_form) }}
            </div>
        </div>

        {% if searched %}
            {% if patients is empty %}
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="alert alert-warning mb-3">
                            Paciente no encontrado en la base de datos.
                        </div>
                        <a href="{{ path('app_admission_patient_register', {
                            identification_type: selected_type_id,
                            identification: search_term,
                            admission_type: page_title == 'Pre-Admisión' ? 'pre' : 'hospitalaria'
                        }) }}"
                           class="btn btn-success"
                           data-turbo-frame="maintainer-content">
                            Agregar paciente
                        </a>
                        <a href="{{ path('app_admission_patient_register_foreign', {
                            admission_type: page_title == 'Pre-Admisión' ? 'pre' : 'hospitalaria'
                        }) }}"
                           class="btn btn-outline-primary ms-2"
                           data-turbo-frame="maintainer-content">
                            Agregar extranjero sin RUT
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="card shadow-sm border-0">
                    <div class="card-header">
                        Resultados
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tipo Doc.</th>
                                <th>Identificación</th>
                                <th>Nombre</th>
                                <th>Teléfono</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for patient in patients %}
                                <tr>
                                    <td>#{{ patient.id }}</td>
                                    <td>{{ patient.identificationType ? patient.identificationType.name : '-' }}</td>
                                    <td>{{ patient.identification }}</td>
                                    <td>{{ patient.name }} {{ patient.lastName }} {{ patient.middleName|default('') }}</td>
                                    <td>{{ patient.mobilePhone }}</td>
                                    <td class="text-end">
                                        {% set admission_type = page_title == 'Pre-Admisión' ? 'pre' : 'hospitalaria' %}
                                        <a href="{{ path('app_admission_wizard_step1', { patientId: patient.id, type: admission_type }) }}"
                                           class="btn btn-primary btn-sm"
                                           data-turbo-frame="admission-wizard-content">
                                            Admitir
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <turbo-frame id="admission-wizard-content" class="d-block mt-4"></turbo-frame>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
