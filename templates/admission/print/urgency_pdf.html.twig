<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comprobante Admisión Urgencia #{{ admission_id }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            color: #1f2937;
            padding: 24px;
            max-width: 21cm;
            margin: 0 auto;
            background: #fff;
        }
        .no-print {
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 2px solid #e5e7eb;
            display: flex;
            gap: 12px;
        }
        .btn {
            border: 1px solid #1f2937;
            background: #fff;
            color: #1f2937;
            padding: 10px 16px;
            cursor: pointer;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
        }
        .btn:hover { background: #f9fafb; }
        .btn-danger { background: #ef4444; color: #fff; border-color: #ef4444; }
        .btn-danger:hover { background: #dc2626; }
        
        .document-header {
            text-align: center;
            padding: 24px 0;
            border-bottom: 3px solid #ef4444;
            margin-bottom: 24px;
            background: #fef2f2;
            margin: -24px -24px 24px -24px;
            padding: 24px;
        }
        .document-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #991b1b;
            margin-bottom: 8px;
        }
        .document-header .subtitle {
            font-size: 14px;
            color: #991b1b;
            font-weight: 600;
        }
        
        .urgency-badge {
            display: inline-block;
            background: #ef4444;
            color: #fff;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 8px;
        }
        
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }
        .info-item {
            padding: 12px;
            background: #f9fafb;
            border-left: 3px solid #ef4444;
            border-radius: 4px;
        }
        .info-item strong {
            display: block;
            font-size: 12px;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        .info-item span {
            display: block;
            font-size: 16px;
            color: #1f2937;
            font-weight: 500;
        }
        
        .section {
            margin: 24px 0;
            padding: 20px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
        }
        .section-title {
            font-size: 16px;
            font-weight: 600;
            color: #1f2937;
            margin-bottom: 16px;
            padding-bottom: 8px;
            border-bottom: 2px solid #e5e7eb;
        }
        
        .footer {
            margin-top: 48px;
            padding-top: 16px;
            border-top: 1px solid #e5e7eb;
            text-align: center;
            font-size: 12px;
            color: #6b7280;
        }
        
        @media print {
            .no-print { display: none !important; }
            body { padding: 0; }
            .btn { display: none; }
            .document-header { margin: 0 0 24px 0; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button class="btn btn-danger" onclick="window.print()">
            <i class="bx bx-printer"></i> Imprimir documento
        </button>
        <button class="btn" onclick="window.close()">
            <i class="bx bx-x"></i> Cerrar
        </button>
    </div>

    <div class="document-header">
        <h1>Comprobante de Admisión Urgencia</h1>
        <p class="subtitle">Sistema - Gestión Hospitalaria</p>
        <span class="urgency-badge">⚠️ URGENCIA</span>
    </div>

    <div class="info-grid">
        <div class="info-item">
            <strong>N° Admisión Urgencia</strong>
            <span>#{{ admission_id }}</span>
        </div>
        <div class="info-item">
            <strong>Tipo de documento</strong>
            <span>{{ document_type|upper }}</span>
        </div>
        <div class="info-item">
            <strong>Fecha de emisión</strong>
            <span>{{ printed_at|date('d/m/Y') }}</span>
        </div>
        <div class="info-item">
            <strong>Hora de emisión</strong>
            <span>{{ printed_at|date('H:i:s') }}</span>
        </div>
    </div>

    <div class="section">
        <h2 class="section-title">Datos del paciente</h2>
        {% if admission_record is defined %}
            <div class="info-grid">
                <div class="info-item">
                    <strong>Nombre completo</strong>
                    <span>{{ admission_record.person.name }} {{ admission_record.person.lastName }} {{ admission_record.person.middleName|default('') }}</span>
                </div>
                <div class="info-item">
                    <strong>Identificación</strong>
                    <span>{{ admission_record.person.identificationType ? admission_record.person.identificationType.name : 'Sin tipo' }} - {{ admission_record.person.identification }}</span>
                </div>
            </div>
        {% else %}
            <p><em>Sin datos de paciente.</em></p>
        {% endif %}
    </div>

    <div class="section">
        <h2 class="section-title">Datos de urgencia</h2>
        {% if admission_record is defined %}
            <div class="info-grid">
                <div class="info-item">
                    <strong>Triage</strong>
                    <span>{{ admission_record.triage|default('-') }}</span>
                </div>
                <div class="info-item">
                    <strong>Motivo consulta</strong>
                    <span>{{ admission_record.consultationReason|default('-') }}</span>
                </div>
                <div class="info-item">
                    <strong>Estado</strong>
                    <span>{{ admission_record.status|capitalize }}</span>
                </div>
                <div class="info-item">
                    <strong>Servicio / Cama</strong>
                    <span>{{ admission_lookups.service_name|default('-') }} / {{ admission_lookups.bed_name|default('-') }}</span>
                </div>
            </div>
        {% else %}
            <p><em>Sin datos de urgencia.</em></p>
        {% endif %}
    </div>

    <div class="footer">
        <p>Este documento es válido como comprobante de admisión de urgencia</p>
        <p>Sistema © {{ 'now'|date('Y') }}</p>
    </div>
</body>
</html>
