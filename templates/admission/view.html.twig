{% extends 'app_layout.html.twig' %}

{% block title %}Ver Admisión - Sistema{% endblock %}

{% block content %}
    <div class="container-fluid px-4 py-4">
        <h1>Detalle de Admisión</h1>
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <p class="mb-2"><strong>ID:</strong> #{{ admission_id }}</p>
                <p class="mb-4"><strong>Tipo:</strong> {{ admission_type|default('hospitalaria')|capitalize }}</p>
                {% if admission_record is defined %}
                    {% set patient = admission_record.patient %}
                    {% set person = patient ? patient.person : null %}
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label text-muted">Paciente</label>
                            <div class="form-control bg-light">
                                {% if person %}
                                    {{ person.name }} {{ person.lastName }} {{ person.middleName|default('') }}
                                {% else %}
                                    -
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted">Identificación</label>
                            <div class="form-control bg-light">
                                {% if person %}
                                    {{ person.identificationType ? person.identificationType.name : 'Sin tipo' }} - {{ person.identification }}
                                {% else %}
                                    -
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted">Estado</label>
                            <div class="form-control bg-light">{{ admission_record.status|capitalize }}</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Financiador / Convenio</label>
                            <div class="form-control bg-light">
                                {{ admission_lookups.payer_name|default('-') }} / {{ admission_lookups.agreement_name|default('-') }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Servicio / Cama</label>
                            <div class="form-control bg-light">
                                {{ admission_lookups.service_name|default('-') }} / {{ admission_lookups.bed_name|default('-') }}
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="d-flex gap-2 justify-content-end">
                    <a href="{{ path(print_route, { id: admission_id, type: 'pdf' }) }}"
                       target="_blank"
                       data-turbo="false"
                       class="btn btn-outline-secondary">
                        Imprimir admisión
                    </a>
                    <form method="post" action="{{ path('app_admission_finalize', { id: admission_id }) }}" class="m-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('admission_finalize_' ~ admission_id) }}">
                        <button type="submit" class="btn btn-success">
                            Guardar y finalizar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
