{% extends 'app_layout.html.twig' %}

{% block title %}Ver Admisión - Sistema{% endblock %}

{% block content %}
    <style>
        .admission-view .section-card {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            background: #fff;
        }
        .admission-view .section-card .card-header {
            border-bottom: 1px solid #e2e8f0;
            background: #f8fafc;
            font-weight: 600;
        }
        .admission-view .info-label {
            display: block;
            color: #64748b;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 0.2rem;
        }
        .admission-view .info-value {
            font-weight: 500;
            color: #0f172a;
        }
        .admission-view .summary-chip {
            border-radius: 999px;
            padding: 0.3rem 0.75rem;
            background: #e2e8f0;
            font-size: 0.82rem;
            font-weight: 600;
            color: #1e293b;
        }
        .admission-view .summary-chip.success {
            background: #dcfce7;
            color: #166534;
        }
        .admission-view .summary-chip.warning {
            background: #fff7ed;
            color: #9a3412;
        }
    </style>

    <div class="container-fluid px-4 py-4">
        <div class="admission-view">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <h1 class="mb-1">Detalle de Admisión</h1>
                    <div class="text-muted">Ficha clínica y administrativa del ingreso</div>
                </div>
                {% set status_name = admission_record is defined and admission_record.admissionStatus ? admission_record.admissionStatus.name : 'Sin estado' %}
                <div class="d-flex flex-wrap gap-2">
                    <span class="summary-chip">Admisión #{{ admission_id }}</span>
                    <span class="summary-chip">{{ admission_type|default('hospitalaria')|capitalize }}</span>
                    <span class="summary-chip {{ status_name|lower == 'admitido' ? 'success' : (status_name|lower == 'anulada' ? 'warning' : '') }}">{{ status_name }}</span>
                </div>
            </div>

            {% if admission_record is defined %}
                {% set patient = admission_record.patient %}
                {% set person = patient ? patient.person : null %}
                {% set patient_name = person ? (person.name ~ ' ' ~ person.lastName ~ ' ' ~ person.middleName|default(''))|trim : '-' %}
                <div class="row g-3 mt-2">
                    <div class="col-12 col-xl-7">
                        <div class="card section-card h-100">
                            <div class="card-header py-3">Paciente</div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <span class="info-label">Nombre completo</span>
                                        <div class="info-value">{{ patient_name }}</div>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="info-label">Identificación</span>
                                        <div class="info-value">
                                            {% if person %}
                                                {{ person.identificationType ? person.identificationType.name : 'Sin tipo' }} - {{ person.identification }}
                                            {% else %}
                                                -
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="info-label">Teléfono móvil</span>
                                        <div class="info-value">{{ person and person.mobilePhone ? person.mobilePhone : '-' }}</div>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="info-label">Email</span>
                                        <div class="info-value">{{ person and person.email ? person.email : '-' }}</div>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="info-label">Fecha nacimiento</span>
                                        <div class="info-value">{{ person and person.birthDateAt ? person.birthDateAt|date('d/m/Y') : '-' }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-5">
                        <div class="card section-card h-100">
                            <div class="card-header py-3">Resumen de ingreso</div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <span class="info-label">Estado</span>
                                        <div class="info-value">{{ status_name }}</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="info-label">Número de ingreso</span>
                                        <div class="info-value">{{ admission_record.number is not null ? admission_record.number : '-' }}</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="info-label">Fecha ingreso</span>
                                        <div class="info-value">{{ admission_record.admissionDate ? admission_record.admissionDate|date('d/m/Y H:i') : '-' }}</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="info-label">Fecha pre-admisión</span>
                                        <div class="info-value">{{ admission_record.preAdmissionDate ? admission_record.preAdmissionDate|date('d/m/Y H:i') : '-' }}</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="info-label">Tipo cuenta</span>
                                        <div class="info-value">{{ admission_record.accountType ? admission_record.accountType.name|default('-') : '-' }}</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="info-label">D.A.U.</span>
                                        <div class="info-value">{{ admission_record.dau is not null ? admission_record.dau : '-' }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card section-card">
                            <div class="card-header py-3">Datos clínicos y administrativos</div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Financiador</span>
                                        <div class="info-value">{{ admission_lookups.payer_name|default('-') }}</div>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Convenio</span>
                                        <div class="info-value">{{ admission_lookups.agreement_name|default('-') }}</div>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Plan previsional</span>
                                        <div class="info-value">{{ admission_record.insurancePlan ? admission_record.insurancePlan.name : '-' }}</div>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Con honorarios</span>
                                        <div class="info-value">{{ admission_record.withFees ? 'Sí' : 'No' }}</div>
                                    </div>

                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Servicio</span>
                                        <div class="info-value">{{ admission_lookups.service_name|default('-') }}</div>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Cama</span>
                                        <div class="info-value">{{ admission_lookups.bed_name|default('-') }}</div>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Sucursal</span>
                                        <div class="info-value">{{ admission_record.branch ? admission_record.branch.name : '-' }}</div>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Origen</span>
                                        <div class="info-value">{{ admission_record.origin ? admission_record.origin.name : '-' }}</div>
                                    </div>

                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Profesional</span>
                                        <div class="info-value">{{ admission_record.professional ? admission_record.professional.fullName : '-' }}</div>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Especialidad</span>
                                        <div class="info-value">{{ admission_record.specialty ? admission_record.specialty.name : '-' }}</div>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Médico derivador</span>
                                        <div class="info-value">{{ admission_record.referringDoctor|default('-') }}</div>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <span class="info-label">Ingreso quirúrgico</span>
                                        <div class="info-value">{{ admission_record.surgicalAdmission ? 'Sí' : 'No' }}</div>
                                    </div>

                                    <div class="col-md-6">
                                        <span class="info-label">Aviso de emergencia</span>
                                        <div class="info-value">{{ admission_record.emergencyNotice|default('-') }}</div>
                                    </div>
                                    <div class="col-md-6">
                                        <span class="info-label">Teléfono de emergencia</span>
                                        <div class="info-value">{{ admission_record.emergencyPhone|default('-') }}</div>
                                    </div>
                                    <div class="col-md-6">
                                        <span class="info-label">Observaciones de ingreso</span>
                                        <div class="info-value">{{ admission_record.notes|default('-') }}</div>
                                    </div>
                                    <div class="col-md-6">
                                        <span class="info-label">Observaciones de anulación</span>
                                        <div class="info-value">{{ admission_record.cancellationNotes|default('-') }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% set print_preview_url = path(print_route, { id: admission_id, type: 'pdf' }) ~ '?preview=1' %}
            {% set resolved_back_url = back_url|default('') ?: (app.request.headers.get('referer') ?: path(finish_route)) %}
            <div class="d-flex gap-2 justify-content-end mt-4">
                <a href="{{ resolved_back_url }}" class="btn btn-outline-secondary" data-turbo-frame="maintainer-content">
                    Volver
                </a>
                <button type="button"
                        class="btn btn-outline-secondary"
                        id="openAdmissionPrintPreview"
                        data-print-preview-url="{{ print_preview_url }}">
                    Vista previa / Imprimir
                </button>
            </div>
        </div>
    </div>

    <style>
        #admissionPrintPreviewModal .modal-dialog {
            max-width: min(1200px, 95vw);
        }
        #admissionPrintPreviewModal .modal-body {
            position: relative;
            overflow: hidden;
            background: #f8fafc;
        }
        #admissionPrintPreviewModal .preview-loader {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            background: rgba(248, 250, 252, 0.92);
            color: #475569;
            font-weight: 500;
            z-index: 2;
            transition: opacity 0.2s ease;
        }
        #admissionPrintPreviewModal .preview-loader.is-hidden {
            opacity: 0;
            pointer-events: none;
        }
    </style>

    <div class="modal fade" id="admissionPrintPreviewModal" tabindex="-1" aria-labelledby="admissionPrintPreviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="admissionPrintPreviewModalLabel">Vista previa de admisión</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-0" style="height: 78vh;">
                    <div id="admissionPreviewLoader" class="preview-loader">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        Cargando vista previa...
                    </div>
                    <iframe id="admissionPrintPreviewFrame"
                            title="Vista previa de impresión"
                            src="about:blank"
                            style="width: 100%; height: 100%; border: 0;"></iframe>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class="btn btn-primary" id="printAdmissionFromModal" disabled>Imprimir</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        (() => {
            const openButton = document.getElementById('openAdmissionPrintPreview');
            const modalElement = document.getElementById('admissionPrintPreviewModal');
            const previewFrame = document.getElementById('admissionPrintPreviewFrame');
            const printButton = document.getElementById('printAdmissionFromModal');
            const previewLoader = document.getElementById('admissionPreviewLoader');

            if (!openButton || !modalElement || !previewFrame || !printButton || !previewLoader || !window.bootstrap) {
                return;
            }
            if (modalElement.dataset.previewInitialized === '1') {
                return;
            }
            modalElement.dataset.previewInitialized = '1';

            const previewModal = window.bootstrap.Modal.getOrCreateInstance(modalElement);
            const setLoading = (isLoading) => {
                previewLoader.classList.toggle('is-hidden', !isLoading);
                printButton.disabled = isLoading;
            };

            openButton.addEventListener('click', () => {
                const previewUrl = openButton.dataset.printPreviewUrl || '';
                if (previewUrl !== '') {
                    setLoading(true);
                    previewFrame.src = previewUrl;
                }
                previewModal.show();
            });

            previewFrame.addEventListener('load', () => {
                setLoading(false);
            });

            printButton.addEventListener('click', () => {
                const frameWindow = previewFrame.contentWindow;
                if (!frameWindow) {
                    return;
                }

                frameWindow.focus();
                frameWindow.print();
            });

            modalElement.addEventListener('hidden.bs.modal', () => {
                setLoading(true);
                previewFrame.src = 'about:blank';
            });
        })();
    </script>
{% endblock %}
