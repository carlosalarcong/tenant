{% extends 'app_layout.html.twig' %}

{% block title %}Ver Admisión - Sistema{% endblock %}

{% block content %}
    <div class="container-fluid px-4 py-4">
        <h1>Detalle de Admisión</h1>
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <p class="mb-2"><strong>ID:</strong> #{{ admission_id }}</p>
                <p class="mb-4"><strong>Tipo:</strong> {{ admission_type|default('hospitalaria')|capitalize }}</p>
                {% if admission_record is defined %}
                    {% set patient = admission_record.patient %}
                    {% set person = patient ? patient.person : null %}
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label text-muted">Paciente</label>
                            <div class="form-control bg-light">
                                {% if person %}
                                    {{ person.name }} {{ person.lastName }} {{ person.middleName|default('') }}
                                {% else %}
                                    -
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted">Identificación</label>
                            <div class="form-control bg-light">
                                {% if person %}
                                    {{ person.identificationType ? person.identificationType.name : 'Sin tipo' }} - {{ person.identification }}
                                {% else %}
                                    -
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted">Estado</label>
                            <div class="form-control bg-light">{{ admission_record.admissionStatus ? admission_record.admissionStatus.name : '-' }}</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Financiador / Convenio</label>
                            <div class="form-control bg-light">
                                {{ admission_lookups.payer_name|default('-') }} / {{ admission_lookups.agreement_name|default('-') }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Servicio / Cama</label>
                            <div class="form-control bg-light">
                                {{ admission_lookups.service_name|default('-') }} / {{ admission_lookups.bed_name|default('-') }}
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% set print_preview_url = path(print_route, { id: admission_id, type: 'pdf' }) ~ '?preview=1' %}
                <div class="d-flex gap-2 justify-content-end">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="openAdmissionPrintPreview"
                            data-print-preview-url="{{ print_preview_url }}">
                        Vista previa / Imprimir
                    </button>
                    <form method="post" action="{{ path('app_admission_finalize', { id: admission_id }) }}" class="m-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('admission_finalize_' ~ admission_id) }}">
                        <button type="submit" class="btn btn-success">
                            Guardar y finalizar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <style>
        #admissionPrintPreviewModal .modal-dialog {
            max-width: min(1200px, 95vw);
        }
        #admissionPrintPreviewModal .modal-body {
            position: relative;
            overflow: hidden;
            background: #f8fafc;
        }
        #admissionPrintPreviewModal .preview-loader {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            background: rgba(248, 250, 252, 0.92);
            color: #475569;
            font-weight: 500;
            z-index: 2;
            transition: opacity 0.2s ease;
        }
        #admissionPrintPreviewModal .preview-loader.is-hidden {
            opacity: 0;
            pointer-events: none;
        }
    </style>

    <div class="modal fade" id="admissionPrintPreviewModal" tabindex="-1" aria-labelledby="admissionPrintPreviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="admissionPrintPreviewModalLabel">Vista previa de admisión</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-0" style="height: 78vh;">
                    <div id="admissionPreviewLoader" class="preview-loader">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        Cargando vista previa...
                    </div>
                    <iframe id="admissionPrintPreviewFrame"
                            title="Vista previa de impresión"
                            src="about:blank"
                            style="width: 100%; height: 100%; border: 0;"></iframe>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class="btn btn-primary" id="printAdmissionFromModal" disabled>Imprimir</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        (() => {
            const openButton = document.getElementById('openAdmissionPrintPreview');
            const modalElement = document.getElementById('admissionPrintPreviewModal');
            const previewFrame = document.getElementById('admissionPrintPreviewFrame');
            const printButton = document.getElementById('printAdmissionFromModal');
            const previewLoader = document.getElementById('admissionPreviewLoader');

            if (!openButton || !modalElement || !previewFrame || !printButton || !previewLoader || !window.bootstrap) {
                return;
            }
            if (modalElement.dataset.previewInitialized === '1') {
                return;
            }
            modalElement.dataset.previewInitialized = '1';

            const previewModal = window.bootstrap.Modal.getOrCreateInstance(modalElement);
            const setLoading = (isLoading) => {
                previewLoader.classList.toggle('is-hidden', !isLoading);
                printButton.disabled = isLoading;
            };

            openButton.addEventListener('click', () => {
                const previewUrl = openButton.dataset.printPreviewUrl || '';
                if (previewUrl !== '') {
                    setLoading(true);
                    previewFrame.src = previewUrl;
                }
                previewModal.show();
            });

            previewFrame.addEventListener('load', () => {
                setLoading(false);
            });

            printButton.addEventListener('click', () => {
                const frameWindow = previewFrame.contentWindow;
                if (!frameWindow) {
                    return;
                }

                frameWindow.focus();
                frameWindow.print();
            });

            modalElement.addEventListener('hidden.bs.modal', () => {
                setLoading(true);
                previewFrame.src = 'about:blank';
            });
        })();
    </script>
{% endblock %}
