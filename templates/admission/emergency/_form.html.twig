{% extends 'app_layout.html.twig' %}

{% block title %}Admisión Urgencia - Sistema{% endblock %}

{% block content %}
    <div class="container-fluid px-4 py-4">
        <h1>Crear Admisión Urgencia</h1>
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <p class="text-muted">Paciente seleccionado: #{{ patient_id }}</p>

                {{ form_start(form, { action: path('app_admission_emergency_create', { patientId: patient_id }) }) }}
                    {% if form_errors(form) %}
                        <div class="alert alert-danger">{{ form_errors(form) }}</div>
                    {% endif %}
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.triage, 'Triage', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.triage, { attr: { class: 'form-select', id: 'triage', required: true } }) }}
                            {{ form_errors(form.triage) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.reason, 'Motivo consulta', { label_attr: { class: 'form-label' } }) }}
                            {{ form_widget(form.reason, { attr: { class: 'form-control', id: 'reason', required: true } }) }}
                            {{ form_errors(form.reason) }}
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a href="{{ path('app_admission_emergency_index') }}"
                           class="btn btn-outline-secondary"
                           data-turbo-frame="maintainer-content">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger">Guardar y continuar</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
