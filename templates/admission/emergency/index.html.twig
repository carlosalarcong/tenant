{% extends 'app_layout.html.twig' %}

{% block title %}{{ page_title }} - Sistema{% endblock %}

{% block content %}
    <div class="container-fluid px-4 py-4">
        <h1>{{ page_title }}</h1>
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body">
                <h5 class="mb-3">Inicio rápido urgencia</h5>
                <p class="text-muted mb-3">Flujo temporal: crear admisión urgencia para paciente #1.</p>
                <a href="{{ path('app_admission_emergency_create', { patientId: 1 }) }}"
                   class="btn btn-danger"
                   data-turbo-frame="maintainer-content">
                    Iniciar Admisión Urgencia
                </a>
            </div>
        </div>
    </div>
{% endblock %}
