{#
    Template parcial para flash messages
    Usado por Turbo Streams para actualizar mensajes después de operaciones CRUD
#}
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-radius: 12px;">
        <i class="bx bx-check-circle me-2"></i>{{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
{% endfor %}

