<div data-controller="revenue--payment-builder"
     data-revenue--payment-builder-total-cuenta-value="0"
     data-action="input->revenue--payment-builder#recalculateTotal change->revenue--payment-builder#recalculateTotal">

    {# ── Total cuenta / Saldo ─────────────────────────────────────────────── #}
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header py-2 border-bottom d-flex align-items-center gap-2">
            <i class="bi bi-wallet2 text-primary"></i>
            <span class="fw-semibold">Medios de pago</span>
        </div>
        <div class="card-body p-3">
            <div class="row g-2">
                <div class="col-6">
                    <div class="bg-light border rounded px-3 py-2 text-center">
                        <div class="text-muted small lh-1 mb-1">Total cuenta</div>
                        <div class="fw-semibold"
                             data-revenue--payment-builder-target="totalCuentaDisplay">$ 0</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="bg-light border rounded px-3 py-2 text-center">
                        <div class="text-muted small lh-1 mb-1">Saldo cuenta</div>
                        <div class="fw-semibold"
                             data-revenue--payment-builder-target="saldoCuenta">$ 0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Métodos de pago ──────────────────────────────────────────────────── #}
    <div class="row g-2 mb-3">
        {% for method_code, method in payment_methods %}
        <div class="col-6">
            <div class="pgm-card" data-method-card="{{ method_code }}">

                <div class="pgm-card-header">
                    <span class="pgm-card-name">{{ method.label }}</span>
                    <div class="form-check form-switch pgm-card-switch mb-0 me-1">
                        <input class="form-check-input"
                               type="checkbox"
                               id="payment-method-switch-{{ method_code }}"
                               data-payment-method-switch="{{ method_code }}"
                               data-action="change->revenue--payment-builder#toggleMethod"
                               role="switch"
                               aria-label="Activar {{ method.label }}">
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-link p-0 text-secondary text-decoration-none lh-1"
                            data-action="click->revenue--payment-builder#deactivateMethod"
                            data-method-code="{{ method_code }}"
                            title="Desactivar {{ method.label }}">
                        <i class="bi bi-x"></i>
                    </button>
                </div>

                <div class="pgm-card-body" data-method-panel="{{ method_code }}">
                    <div class="pgm-card-body-inner">
                        <div data-method-rows="{{ method_code }}">
                            {% if initial_rows[method_code] is defined %}
                                {{ include(method.row_template, {
                                    row_form: initial_rows[method_code],
                                    method_code: method_code,
                                    index: 0,
                                    row_name_prefix: 'payment_batch[rows][' ~ method_code ~ '][0]'
                                }) }}
                            {% endif %}
                        </div>
                    </div>
                </div>

            </div>
        </div>
        {% endfor %}
    </div>

    {# Alerta de estado — gestionada por Stimulus, oculta por defecto #}
    <div class="pgm-status-alert pgm-alert-info d-none"
         data-revenue--payment-builder-target="statusAlert">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        <span data-revenue--payment-builder-target="statusAlertText"></span>
    </div>

    {# ── Acciones ─────────────────────────────────────────────────────────── #}
    <div class="d-flex justify-content-end gap-2 pt-2 border-top mt-1">
        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                data-action="click->revenue--cash-register#cancelPayment">
            Cancelar
        </button>
        <button type="button"
                class="btn btn-success btn-sm"
                data-revenue--payment-builder-target="payButton"
                data-action="click->revenue--cash-register#submitPayment"
                disabled
                title="Se habilita cuando el Saldo Cuenta llega a $0">
            <i class="bi bi-check-lg me-1"></i>Efectuar pago
        </button>
    </div>

</div>
