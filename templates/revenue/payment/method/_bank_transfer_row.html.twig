<div class="payment-row" data-payment-row data-method-code="{{ method_code }}" data-row-index="{{ index }}">
    {# Fila 1: Banco | N° Operación | Titular #}
    <div class="row g-2 mb-2">
        <div class="col-12 col-md-3">
            <label class="form-label">Banco <span class="text-danger ms-1">*</span></label>
            {{ form_widget(row_form.bank_id, {
                full_name: row_name_prefix ~ '[bank_id]',
                attr: { class: 'form-select' }
            }) }}
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">N° Operación <span class="text-danger ms-1">*</span></label>
            {{ form_widget(row_form.transfer_number, {
                full_name: row_name_prefix ~ '[transfer_number]',
                attr: { class: 'form-control', placeholder: 'N° operación' }
            }) }}
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">Titular</label>
            {{ form_widget(row_form.account_holder, {
                full_name: row_name_prefix ~ '[account_holder]',
                attr: { class: 'form-control', placeholder: 'Titular cuenta origen' }
            }) }}
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">Monto <span class="text-danger ms-1">*</span></label>
            {{ form_widget(row_form.amount, {
                full_name: row_name_prefix ~ '[amount]',
                attr: {
                    class: 'form-control',
                    'data-payment-amount-input': '1',
                    placeholder: 'Ej: 150000'
                }
            }) }}
        </div>
    </div>
</div>
