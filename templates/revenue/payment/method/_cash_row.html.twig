<div class="payment-row card border-0 bg-light-subtle mb-2" data-payment-row data-method-code="{{ method_code }}" data-row-index="{{ index }}">
    <div class="card-body p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-10">
                {{ form_label(row_form.amount, 'Monto', { label_attr: { class: 'form-label mb-1' } }) }}
                {{ form_widget(row_form.amount, {
                    full_name: row_name_prefix ~ '[amount]',
                    attr: { class: 'form-control' }
                }) }}
            </div>
            <div class="col-md-2 d-grid">
                <button type="button"
                        class="btn btn-outline-danger"
                        data-action="click->revenue--payment-builder#removeRow">
                    Quitar
                </button>
            </div>
        </div>
    </div>
</div>
