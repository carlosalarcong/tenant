<div class="payment-row" data-payment-row data-method-code="{{ method_code }}" data-row-index="{{ index }}">
    <div class="row g-2">
        <div class="col-12 col-md-4">
            <label class="form-label">Tarjeta <span class="text-danger ms-1">*</span></label>
            {{ form_widget(row_form.card_id, {
                full_name: row_name_prefix ~ '[card_id]',
                attr: { class: 'form-select' }
            }) }}
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label">Voucher <span class="text-danger ms-1">*</span></label>
            {{ form_widget(row_form.voucher, {
                full_name: row_name_prefix ~ '[voucher]',
                attr: { class: 'form-control', placeholder: 'N° voucher' }
            }) }}
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label">Monto <span class="text-danger ms-1">*</span></label>
            {{ form_widget(row_form.amount, {
                full_name: row_name_prefix ~ '[amount]',
                attr: {
                    class: 'form-control',
                    'data-payment-amount-input': '1',
                    placeholder: 'Ej: 150000'
                }
            }) }}
        </div>
    </div>
</div>
