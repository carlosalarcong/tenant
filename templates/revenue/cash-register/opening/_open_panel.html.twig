{#
  Turbo Frame: cash-register-open
  Panel de apertura de caja. Renderiza contenido según el estado operativo del cajero.

  Parámetros:
    status        string  — 'closed' | 'open' | 'unclosed' | 'no_voucher'
    locations     CashRegisterLocation[]  — lista de ubicaciones activas (solo si status='closed')
    openRegister  CashRegister|null       — caja abierta actualmente (si status='open'|'no_voucher')

  Legacy: gestionAbrirCajaAction (vista)
#}
<turbo-frame id="cash-register-open">

  {# ── Mensajes flash ── #}
  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'warning' ? 'warning' : 'danger') }} alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
        <i class="bx {{ label == 'success' ? 'bx-check-circle' : 'bx-error-circle' }} fs-5" aria-hidden="true"></i>
        <span>{{ message }}</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
      </div>
    {% endfor %}
  {% endfor %}

  {# ════════════════════════════════════════════════════
     ESTADO: closed — formulario de apertura (flujo normal)
     ════════════════════════════════════════════════════ #}
  {% if status == 'closed' %}

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white d-flex align-items-center gap-2 py-2">
        <i class="bx bx-log-in-circle text-primary fs-5" aria-hidden="true"></i>
        <strong class="me-auto">Abrir caja</strong>
      </div>

      <div class="card-body">
        {% if locations is empty %}
          <div class="alert alert-warning d-flex align-items-center gap-2 mb-0">
            <i class="bx bx-error-circle fs-5" aria-hidden="true"></i>
            <span>No hay ubicaciones de caja activas configuradas. Contacte al administrador.</span>
          </div>
        {% else %}
          <form method="post"
                action="{{ path('app_revenue_cash_register_open_submit') }}"
                data-turbo-frame="cash-register-open">
            <input type="hidden" name="_token" value="{{ csrf_token('cash_register_open') }}">

            <div class="mb-4">
              <label for="location_id" class="form-label fw-semibold">
                Seleccione la ubicación de caja
              </label>
              <select id="location_id" name="location_id" class="form-select" required>
                <option value="">— Seleccione —</option>
                {% for loc in locations %}
                  <option value="{{ loc.id }}">{{ loc.name }}{% if loc.branch %} · {{ loc.branch.name }}{% endif %}</option>
                {% endfor %}
              </select>
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">
                <i class="bx bx-power-off me-1" aria-hidden="true"></i>
                Abrir caja
              </button>
            </div>
          </form>
        {% endif %}
      </div>
    </div>

  {# ════════════════════════════════════════════════════
     ESTADO: open — caja ya abierta hoy
     ════════════════════════════════════════════════════ #}
  {% elseif status == 'open' %}

    <div class="card border-0 border-start border-4 border-success shadow-sm">
      <div class="card-body d-flex align-items-start gap-3">
        <i class="bx bx-check-circle text-success fs-2 flex-shrink-0 mt-1" aria-hidden="true"></i>
        <div class="flex-grow-1">
          <p class="fw-semibold mb-1">Caja abierta</p>
          {% if openRegister %}
            <p class="text-muted small mb-2">
              <strong>{{ openRegister.cashRegisterLocation.name }}</strong>
              · Apertura: {{ openRegister.openedAt|date('d/m/Y H:i') }}
            </p>
          {% endif %}
          <a href="{{ openRegister ? path('app_revenue_cash_register_close', {id: openRegister.id}) : '#' }}"
             class="btn btn-sm btn-outline-danger"
             data-turbo-frame="_top">
            <i class="bx bx-log-out-circle me-1" aria-hidden="true"></i>
            Cerrar caja
          </a>
        </div>
      </div>
    </div>

  {# ════════════════════════════════════════════════════
     ESTADO: unclosed — caja anterior sin cerrar
     ════════════════════════════════════════════════════ #}
  {% elseif status == 'unclosed' %}

    <div class="card border-0 border-start border-4 border-warning shadow-sm">
      <div class="card-body d-flex align-items-start gap-3">
        <i class="bx bx-error text-warning fs-2 flex-shrink-0 mt-1" aria-hidden="true"></i>
        <div>
          <p class="fw-semibold mb-1">Caja de día anterior sin cerrar</p>
          <p class="text-muted small mb-2">
            Tienes una caja abierta de un día anterior que no fue cerrada correctamente.
            Debes cerrarla antes de abrir una nueva sesión.
          </p>
          {% if openRegister %}
            <a href="{{ path('app_revenue_cash_register_close', {id: openRegister.id}) }}"
               class="btn btn-sm btn-warning"
               data-turbo-frame="_top">
              <i class="bx bx-lock-alt me-1" aria-hidden="true"></i>
              Ir a cerrar caja anterior
              <span class="text-muted ms-1">({{ openRegister.openedAt|date('d/m/Y') }})</span>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

  {# ════════════════════════════════════════════════════
     ESTADO: no_voucher — sin talonario con folios
     ════════════════════════════════════════════════════ #}
  {% elseif status == 'no_voucher' %}

    <div class="card border-0 border-start border-4 border-danger shadow-sm">
      <div class="card-body d-flex align-items-start gap-3">
        <i class="bx bx-receipt text-danger fs-2 flex-shrink-0 mt-1" aria-hidden="true"></i>
        <div>
          <p class="fw-semibold mb-1">Sin talonario disponible</p>
          <p class="text-muted small mb-0">
            La caja activa no tiene un talonario con folios disponibles.
            Contacte al administrador para asignar un nuevo talonario antes de operar.
          </p>
          {% if openRegister %}
            <p class="text-muted small mt-1">
              Caja activa: <strong>{{ openRegister.cashRegisterLocation.name }}</strong>
              · Desde: {{ openRegister.openedAt|date('d/m/Y H:i') }}
            </p>
          {% endif %}
        </div>
      </div>
    </div>

  {% endif %}

</turbo-frame>
