{# ──────────────────────────────────────────────────────────────────────────
   Orquestador principal del módulo de caja.

   Parámetros heredados del template padre (o pasados explícitamente):
     context            string  — 'direct' | 'from_admission' | 'from_appointment'
     admissionRecordId  int
     appointmentId      int
     servicesUrl        string
     differenceFormUrl  string
     statusBarUrl       string
     patientSearchUrl   string
     confirmUrl         string
     payment_methods    array
     initial_rows       array

   Parámetros propios de este partial:
     show_header  bool  — si false, oculta el encabezado (título + status bar).
                          Usar false cuando se embebe en revenue/dashboard.
                          Default: true (comportamiento standalone).

   Stimulus: revenue--cash-register
   Escucha (data-action delega en el elemento raíz):
     - patient:selected          → onPatientSelected
     - services:total-changed    → onServicesTotalChanged
     - difference:approved       → onDifferenceApproved
   Inyecta (en onPaymentFormSubmit, justo antes del POST):
     - patient_id        desde turbo-frame#patient-context  → #ctx-patient-id
     - services_payload  desde turbo-frame#services-panel   → #services-payload-hidden
────────────────────────────────────────────────────────────────────────── #}
<div class="container-fluid px-3 py-2"
     data-controller="revenue--cash-register"
     data-revenue--cash-register-services-url-value="{{ servicesUrl }}"
     data-revenue--cash-register-difference-form-url-value="{{ differenceFormUrl }}"
     data-revenue--cash-register-admission-record-id-value="{{ admissionRecordId }}"
     data-revenue--cash-register-appointment-id-value="{{ appointmentId }}"
     data-action="patient:selected->revenue--cash-register#onPatientSelected
                  services:total-changed->revenue--cash-register#onServicesTotalChanged
                  difference:approved->revenue--cash-register#onDifferenceApproved">

    {# ── Encabezado (título + barra de estado) ────────────────────────────── #}
    {% if show_header ?? true %}
    <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">

        <h4 class="mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-cash-register text-primary"></i>
            {% if context == 'from_admission' %}
                Cobro · Admisión&nbsp;<span class="text-muted fw-normal fs-6">#{{ admissionRecordId }}</span>
            {% elseif context == 'from_appointment' %}
                Cobro · Cita&nbsp;<span class="text-muted fw-normal fs-6">#{{ appointmentId }}</span>
            {% else %}
                Cobro directo
            {% endif %}
        </h4>

        {# ── Barra de estado de caja (Turbo Frame lazy) ──────────────────── #}
        <turbo-frame id="cash-register-status-bar"
                     loading="lazy"
                     src="{{ statusBarUrl }}">
            <span class="spinner-border spinner-border-sm text-secondary me-1" role="status" aria-hidden="true"></span>
            <span class="text-muted small">Cargando estado de caja...</span>
        </turbo-frame>

    </div>
    {% endif %}

    {# ── Layout de dos columnas ──────────────────────────────────────────── #}
    <div class="row g-3">

        {# ════════════════════════════════════════════════════════════════════
           COLUMNA IZQUIERDA — Paciente
        ═══════════════════════════════════════════════════════════════════ #}
        <div class="col-12 col-xl-4">

            {# ── Búsqueda de paciente ──────────────────────────────────── #}
            <turbo-frame id="patient-search"
                         src="{{ patientSearchUrl }}">
                <div class="card">
                    <div class="card-body text-center text-muted py-4 small">
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        Cargando búsqueda de paciente...
                    </div>
                </div>
            </turbo-frame>

            {# ── Contexto del paciente (carga lazy al seleccionar) ────── #}
            <turbo-frame id="patient-context" class="d-block mt-3">
                {# Vacío — se popula cuando patient-search-controller carga /{id}/context #}
            </turbo-frame>

        </div>

        {# ════════════════════════════════════════════════════════════════════
           COLUMNA DERECHA — Prestaciones + Diferencia + Pago
        ═══════════════════════════════════════════════════════════════════ #}
        <div class="col-12 col-xl-8">

            {# ── Panel de prestaciones ─────────────────────────────────── #}
            {# Se carga lazy cuando el cajero selecciona un paciente.
               Mientras tanto muestra un aviso instructivo.              #}
            <div data-revenue--cash-register-target="servicesPanelWrapper">
                <turbo-frame id="services-panel">
                    <div class="card border-0 bg-light">
                        <div class="card-body text-center text-muted py-5">
                            <i class="bi bi-person-check fs-2 d-block mb-2 opacity-50"></i>
                            <p class="mb-0 small">Seleccione un paciente para agregar prestaciones.</p>
                        </div>
                    </div>
                </turbo-frame>
            </div>

            {# ── Barra de acciones (total + botón diferencia) ─────────── #}
            {# Oculta hasta que haya prestaciones con monto > 0.           #}
            <div class="d-none d-flex justify-content-between align-items-center
                        mt-2 mb-2 px-1"
                 data-revenue--cash-register-target="actionsBar">

                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small">Total a cobrar:</span>
                    <span class="fw-bold fs-5 text-success"
                          data-revenue--cash-register-target="totalDisplay">
                        $ 0
                    </span>
                    <span class="badge bg-warning-subtle text-warning-emphasis"
                          data-revenue--cash-register-target="discountBadge"
                          style="display:none">
                        con descuento
                    </span>
                </div>

                <button type="button"
                        class="btn btn-outline-warning btn-sm"
                        data-action="click->revenue--cash-register#requestDifference">
                    <i class="bi bi-percent me-1"></i> Solicitar descuento
                </button>

            </div>

            {# ── Panel de diferencia (carga bajo demanda) ─────────────── #}
            <turbo-frame id="difference-panel" class="d-block mb-2">
                {# Vacío — se popula desde DifferenceController cuando el
                   cajero pulsa "Solicitar descuento"                    #}
            </turbo-frame>

            {# ── Panel de pago ────────────────────────────────────────── #}
            {# Oculto hasta que haya prestaciones con monto > 0.           #}
            <div data-revenue--cash-register-target="paymentSection" class="d-none">

                <turbo-frame id="payment-panel">

                    <div class="card mt-2">
                        <div class="card-header bg-white py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-wallet2 text-primary"></i>
                            <span class="fw-semibold">Medios de pago</span>
                        </div>
                        <div class="card-body">

                            {# Formulario principal de cobro.
                               El orquestador inyecta patient_id y services_payload
                               justo antes del submit (onPaymentFormSubmit).        #}
                            <form id="payment-confirm-form"
                                  method="POST"
                                  action="{{ confirmUrl }}"
                                  data-action="submit->revenue--cash-register#onPaymentFormSubmit">

                                {# ── Campos ocultos ──────────────────────── #}
                                <input type="hidden"
                                       name="_csrf_token"
                                       value="{{ csrf_token('payment_confirm') }}">
                                <input type="hidden"
                                       name="patient_id"
                                       id="payment-patient-id"
                                       value="">
                                <input type="hidden"
                                       name="services_payload"
                                       id="payment-services-payload"
                                       value="">
                                <input type="hidden"
                                       name="admission_record_id"
                                       value="{{ admissionRecordId ?: '' }}">
                                <input type="hidden"
                                       name="appointment_id"
                                       value="{{ appointmentId ?: '' }}">

                                {# ── Builder de medios de pago ───────────── #}
                                {{ include('revenue/payment/_batch.html.twig', {
                                    payment_methods: payment_methods,
                                    initial_rows:    initial_rows
                                }) }}

                                {# ── Botón confirmar ─────────────────────── #}
                                <div class="mt-3 d-grid">
                                    <button type="submit"
                                            class="btn btn-success btn-lg"
                                            data-revenue--cash-register-target="confirmButton"
                                            data-payment-continue-btn>
                                        <i class="bi bi-check-circle me-1"></i>
                                        Confirmar pago
                                    </button>
                                </div>

                            </form>

                        </div>
                    </div>

                </turbo-frame>

            </div>{# /paymentSection #}

        </div>{# /col-xl-8 #}

    </div>{# /row #}

</div>{# /container-fluid [data-controller] #}
