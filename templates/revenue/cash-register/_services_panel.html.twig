<turbo-frame id="services-panel">
    <div data-controller="revenue--services-selector"
         data-revenue--services-selector-search-url-value="{{ path('app_revenue_cash_register_services_search') }}"
         data-revenue--services-selector-add-url-value="{{ path('app_revenue_cash_register_services_add') }}"
         data-revenue--services-selector-remove-url-value="{{ path('app_revenue_cash_register_services_remove') }}"
         data-revenue--services-selector-csrf-add-value="{{ csrf_token('services_add') }}"
         data-revenue--services-selector-csrf-remove-value="{{ csrf_token('services_remove') }}">

        {# ── Header — Agregar ────────────────────────────────────────────────── #}
        <div class="d-flex align-items-center px-3 py-2 mb-3 rounded"
             style="background-color: #555; color: #fff;">
            <span class="fw-semibold">➕ Agregar</span>
        </div>

        {# ── Buscador de prestación ──────────────────────────────────────────── #}
        <div class="row g-2 mb-3 align-items-end">

            {# Nombre de la prestación (autocomplete) #}
            <div class="col">
                <label class="form-label form-label-sm">
                    Prestación <span class="text-danger">*</span>
                </label>
                <div class="position-relative">
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="Buscar por nombre..."
                           autocomplete="off"
                           data-revenue--services-selector-target="searchInput"
                           data-action="input->revenue--services-selector#onSearchInput keydown->revenue--services-selector#onSearchKeydown">
                    <div class="list-group position-absolute w-100 shadow"
                         data-revenue--services-selector-target="searchDropdown"
                         style="top:100%; left:0; z-index:1050; display:none;">
                    </div>
                </div>
                {# IDs del ítem seleccionado — no visibles #}
                <input type="hidden" data-revenue--services-selector-target="selectedItemId" value="">
                <input type="hidden" data-revenue--services-selector-target="selectedItemName" value="">
            </div>

            {# Campos ocultos con valores por defecto #}
            <input type="hidden" value="1"  data-revenue--services-selector-target="addQuantity">
            <input type="hidden" value="0"  data-revenue--services-selector-target="addUnitAmount">
            <input type="hidden" value="0"  data-revenue--services-selector-target="addDiscount">

            {# Botón Buscar / Agregar #}
            <div class="col-auto d-grid">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        data-action="click->revenue--services-selector#onAddClick"
                        data-revenue--services-selector-target="addButton"
                        title="Agregar prestación"
                        disabled>
                    🔍 Buscar
                </button>
            </div>

        </div>

        {# ── Header — Listado Servicios Pago ────────────────────────────────── #}
        <div class="d-flex align-items-center justify-content-between px-3 py-2 mb-2 rounded"
             style="background-color: #555; color: #fff;">
            <span class="fw-semibold">☰ Listado Servicios Pago</span>
            <button type="button" class="btn btn-sm btn-warning" disabled
                    title="Pendiente de implementar">
                ✏ Editar
            </button>
        </div>

        {# ── Tabla de prestaciones ─────────────────────────────────────────── #}
        <div class="table-responsive mb-2">
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:150px">Código</th>
                        <th style="width:90px">Pabellón</th>
                        <th>Nombre</th>
                        <th class="text-center" style="width:80px">Cantidad</th>
                        <th class="text-end"    style="width:110px">Valor</th>
                        <th class="text-end"    style="width:110px">Total</th>
                        <th                     style="width:48px"></th>
                    </tr>
                </thead>
                <tbody id="services-table-body">
                    {% for row in rows %}
                        {% include 'revenue/cash-register/_services_row.html.twig' with { row: row } %}
                    {% else %}
                        <tr id="services-empty-row">
                            <td colspan="7" class="text-center text-muted py-3 small">
                                Sin prestaciones agregadas. Use el buscador para agregar.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                {# ── Fila de Total Cuenta ──────────────────────────────────── #}
                <tfoot>
                    <tr>
                        <td colspan="5" class="text-end fw-bold border-0">Total Cuenta:</td>
                        <td class="text-end fw-bold border-0" id="services-total-display"
                            data-revenue--services-selector-target="totalDisplay">
                            $ {{ total|number_format(0, ',', '.') }}
                        </td>
                        <td class="border-0"></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        {# ── Payload serializado ───────────────────────────────────────────── #}
        <input type="hidden"
               id="services-payload-hidden"
               name="services_payload"
               value="{{ payload }}"
               data-revenue--services-selector-target="payloadHidden">

    </div>
</turbo-frame>
