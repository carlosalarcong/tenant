<turbo-frame id="patient-search">
    {# Borde naranja en foco del campo de identificación (§3a) #}
    <style>
        .rv-id-input:focus {
            border-color: #fd7e14;
            box-shadow: 0 0 0 0.2rem rgba(253, 126, 20, 0.25);
        }
    </style>

    <div data-controller="revenue--patient-search"
         data-revenue--patient-search-search-url-value="{{ path('app_revenue_cash_register_patient_find') }}">

        {# ── Sub-tabs Simple / Avanzada ─────────────────────────────────────── #}
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button type="button"
                        class="nav-link active"
                        data-action="click->revenue--patient-search#showSimple">
                    🔍 Busqueda Simple
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link"
                        data-action="click->revenue--patient-search#showAdvanced">
                    🔍 Busqueda Avanzada
                </button>
            </li>
        </ul>

        {# ── Panel: Búsqueda Simple ──────────────────────────────────────────── #}
        <div data-revenue--patient-search-target="simpleTab">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label small mb-1">Tipo de Identificación</label>
                    <select class="form-select form-select-sm" style="min-width: 110px">
                        <option>Rut</option>
                    </select>
                </div>
                <div class="col">
                    <label class="form-label small mb-1">
                        Campo Identificación <span class="text-danger">*</span>
                    </label>
                    <input type="text"
                           class="form-control form-control-sm rv-id-input"
                           placeholder="Ingrese identificación..."
                           autocomplete="off"
                           data-revenue--patient-search-target="input"
                           data-action="input->revenue--patient-search#onInput keydown->revenue--patient-search#onKeydown">
                </div>
                <div class="col-auto">
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            data-action="click->revenue--patient-search#onSearch">
                        🔍 Buscar
                    </button>
                </div>
            </div>
        </div>

        {# ── Panel: Búsqueda Avanzada ────────────────────────────────────────── #}
        <div data-revenue--patient-search-target="advancedTab" style="display: none">
            <div class="row g-2 mb-2">
                <div class="col">
                    <label class="form-label small mb-1">
                        Nombre <span class="text-warning fw-bold">**</span>
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="Nombre..."
                           autocomplete="off"
                           data-revenue--patient-search-target="nombre">
                </div>
                <div class="col">
                    <label class="form-label small mb-1">
                        Apellido Paterno <span class="text-warning fw-bold">**</span>
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="Apellido paterno..."
                           autocomplete="off"
                           data-revenue--patient-search-target="apellidoPaterno">
                </div>
                <div class="col">
                    <label class="form-label small mb-1">
                        Apellido Materno <span class="text-warning fw-bold">**</span>
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="Apellido materno..."
                           autocomplete="off"
                           data-revenue--patient-search-target="apellidoMaterno">
                </div>
            </div>

            <div class="mb-2">
                <span class="small text-muted me-2">Parámetros de Búsqueda:</span>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="rv_match_type" value="contains"
                           id="rv_match_contains"
                           data-revenue--patient-search-target="matchType">
                    <label class="form-check-label small" for="rv_match_contains">Que contenga</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="rv_match_type" value="starts"
                           id="rv_match_starts"
                           data-revenue--patient-search-target="matchType">
                    <label class="form-check-label small" for="rv_match_starts">Que inicie</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="rv_match_type" value="exact"
                           id="rv_match_exact"
                           checked
                           data-revenue--patient-search-target="matchType">
                    <label class="form-check-label small" for="rv_match_exact">Exacta</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        data-action="click->revenue--patient-search#onSearchAdvanced">
                    🔍 Buscar
                </button>
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        data-action="click->revenue--patient-search#onClear">
                    ✏ Limpiar
                </button>
            </div>
        </div>

        {# ── Dropdown de resultados (compartido entre ambos paneles) ─────────── #}
        <div class="position-relative mt-1">
            <div class="list-group position-absolute w-100 shadow"
                 data-revenue--patient-search-target="dropdown"
                 style="top: 0; left: 0; z-index: 1050; display: none;">
            </div>
        </div>

    </div>
</turbo-frame>
