<turbo-frame id="patient-context">

    {# ── Campos hidden para el formulario de cobro ─────────────────────────── #}
    <input type="hidden" id="ctx-patient-id"         name="patient_id"         value="{{ patient.id }}">
    <input type="hidden" id="ctx-payer-id"           name="payer_id"           value="{{ patient.payer ? patient.payer.id : '' }}">
    <input type="hidden" id="ctx-agreement-id"       name="agreement_id"       value="{{ patient.agreement ? patient.agreement.id : '' }}">
    <input type="hidden" id="ctx-plan-id"            name="plan_id"            value="{{ patient.insurancePlan ? patient.insurancePlan.id : '' }}">
    <input type="hidden" id="ctx-patient-account-id" name="patient_account_id" value="{{ patientAccount ? patientAccount.id : '' }}">

    {# ── Datos del paciente ────────────────────────────────────────────────── #}
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header py-2 border-bottom d-flex align-items-center gap-2">
            <i class="bi bi-person-vcard text-primary"></i>
            <span class="fw-semibold">Información del paciente</span>
            {% if patientAccount %}
                <span class="badge bg-success-subtle text-success-emphasis ms-auto">
                    Cuenta #{{ patientAccount.id }}
                </span>
            {% else %}
                <span class="badge bg-secondary-subtle text-secondary-emphasis ms-auto">Sin cuenta</span>
            {% endif %}
        </div>
        <div class="card-body py-3">
            <dl class="row g-0 mb-0 small">
                <dt class="col-5 text-muted fw-normal">RUT</dt>
                <dd class="col-7 fw-semibold mb-2">{{ patient.person.identification ?? '—' }}</dd>

                <dt class="col-5 text-muted fw-normal">Nombre</dt>
                <dd class="col-7 mb-2">{{ patient.person.name ?? '—' }}</dd>

                <dt class="col-5 text-muted fw-normal">Apellidos</dt>
                <dd class="col-7 mb-2">
                    {{ patient.person.lastName ?? '—' }}
                    {% if patient.person.motherName is defined and patient.person.motherName %}
                        {{ patient.person.motherName }}
                    {% endif %}
                </dd>

                <dt class="col-5 text-muted fw-normal">Nacimiento</dt>
                <dd class="col-7 mb-2">
                    {{ patient.person.birthDateAt ? patient.person.birthDateAt|date('d/m/Y') : '—' }}
                    {% if patient.person.birthDateAt %}
                        <span class="text-muted">({{ date().diff(patient.person.birthDateAt).y }} años)</span>
                    {% endif %}
                </dd>

                <dt class="col-5 text-muted fw-normal">Previsión</dt>
                <dd class="col-7 mb-0">{{ patient.payer ? patient.payer.name : '—' }}</dd>
            </dl>
        </div>
    </div>

    {# ── Datos de prestación ───────────────────────────────────────────────── #}
    <div class="card border-0 shadow-sm">
        <div class="card-header py-2 border-bottom d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clipboard2-pulse text-primary"></i>
                <span class="fw-semibold">Datos de prestación</span>
            </div>
            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    data-bs-toggle="collapse"
                    data-bs-target="#ctx-prestacion-form">
                <i class="bi bi-pencil me-1"></i>Editar
            </button>
        </div>

        {# ── Vista lectura (por defecto) ──────────────────────────────────── #}
        <div id="ctx-prestacion-view" class="card-body py-3">
            <dl class="row g-0 mb-0 small">
                <dt class="col-5 text-muted fw-normal">Financiador</dt>
                <dd class="col-7 mb-2">{{ patient.payer ? patient.payer.name : '—' }}</dd>

                <dt class="col-5 text-muted fw-normal">Convenio</dt>
                <dd class="col-7 mb-2">{{ patient.agreement ? patient.agreement.name : '—' }}</dd>

                <dt class="col-5 text-muted fw-normal">Plan</dt>
                <dd class="col-7 mb-2">{{ patient.insurancePlan ? patient.insurancePlan.name : '—' }}</dd>

                <dt class="col-5 text-muted fw-normal">Origen</dt>
                <dd class="col-7 mb-2">—</dd>

                <dt class="col-5 text-muted fw-normal">Derivado por</dt>
                <dd class="col-7 mb-2">—</dd>

                <dt class="col-5 text-muted fw-normal">Derivado externo</dt>
                <dd class="col-7 mb-0">No</dd>
            </dl>
        </div>

        {# ── Vista formulario (edición) ───────────────────────────────────── #}
        <div id="ctx-prestacion-form" class="collapse border-top">
            <div class="card-body py-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small mb-1">
                            Financiador <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-sm" name="ctx_financiador">
                            {% if patient.payer %}
                                <option value="{{ patient.payer.id }}" selected>{{ patient.payer.name }}</option>
                            {% else %}
                                <option value="">— Sin financiador —</option>
                            {% endif %}
                        </select>

                        <label class="form-label small mb-1 mt-2">Convenio</label>
                        <select class="form-select form-select-sm" name="ctx_convenio">
                            <option value="">— Sin convenio —</option>
                            {% if patient.agreement %}
                                <option value="{{ patient.agreement.id }}" selected>{{ patient.agreement.name }}</option>
                            {% endif %}
                        </select>

                        <label class="form-label small mb-1 mt-2">
                            Plan <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-sm" name="ctx_plan">
                            <option value="">— Sin plan —</option>
                            {% if patient.insurancePlan %}
                                <option value="{{ patient.insurancePlan.id }}" selected>{{ patient.insurancePlan.name }}</option>
                            {% endif %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Origen</label>
                        <select class="form-select form-select-sm" name="ctx_origen">
                            <option value="">— Seleccionar —</option>
                        </select>

                        <label class="form-label small mb-1 mt-2">Derivado por</label>
                        <input type="text"
                               class="form-control form-control-sm"
                               name="ctx_derivado_por"
                               placeholder="Profesional derivador...">

                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox"
                                   id="ctx-derivado-externo" name="ctx_derivado_externo" value="1">
                            <label class="form-check-label small" for="ctx-derivado-externo">
                                Derivado externo
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Footer ───────────────────────────────────────────────────────── #}
        <div class="card-footer d-flex justify-content-end gap-2 py-2 bg-transparent">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-action="click->revenue--cash-register#cancelPatient">
                Cancelar
            </button>
            <button type="button"
                    class="btn btn-sm btn-success"
                    data-action="click->revenue--cash-register#selectPaymentMethod">
                <i class="bi bi-credit-card me-1"></i>Seleccionar medio de pago
            </button>
        </div>
    </div>

</turbo-frame>
