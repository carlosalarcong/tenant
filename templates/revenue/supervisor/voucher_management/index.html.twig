{% extends 'app_layout.html.twig' %}

{% block content %}
<div class="container-fluid px-3 py-2">

    {# ── Encabezado ──────────────────────────────────────────────────────── #}
    <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
        <h4 class="mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-journal-text text-primary"></i>
            Gestión de Folios
        </h4>
    </div>

    {# ── Flash messages ───────────────────────────────────────────────────── #}
    {% for msg in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>{{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i>{{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# ── Filtros ──────────────────────────────────────────────────────────── #}
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <form method="GET" class="row g-2 align-items-end">
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1">N° Folio</label>
                    <input type="number" name="folio" class="form-control form-control-sm"
                           value="{{ folioFilter }}" placeholder="Ej: 1234">
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1">Estado</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="all"       {{ statusFilter == 'all'       ? 'selected' : '' }}>Todos</option>
                        <option value="active"    {{ statusFilter == 'active'    ? 'selected' : '' }}>Vigentes</option>
                        <option value="cancelled" {{ statusFilter == 'cancelled' ? 'selected' : '' }}>Anulados</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1">Desde</label>
                    <input type="date" name="date_from" class="form-control form-control-sm"
                           value="{{ dateFrom }}">
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1">Hasta</label>
                    <input type="date" name="date_to" class="form-control form-control-sm"
                           value="{{ dateTo }}">
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-search me-1"></i> Filtrar
                    </button>
                </div>
                <div class="col-12 col-md-2">
                    <a href="{{ path('app_revenue_supervisor_vouchers_index') }}"
                       class="btn btn-outline-secondary btn-sm w-100">
                        <i class="bi bi-x-circle me-1"></i> Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    {# ── Tabla ────────────────────────────────────────────────────────────── #}
    {% if entries is empty %}
        <div class="card border-0 bg-light">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                <p class="mb-0">No se encontraron folios con los filtros aplicados.</p>
            </div>
        </div>
    {% else %}
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>N° Folio</th>
                            <th>Talonario</th>
                            <th>Ubicación caja</th>
                            <th>Cajero</th>
                            <th>Emisión</th>
                            <th>Estado</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for entry in entries %}
                        <tr>
                            <td><span class="text-muted small">{{ entry.id }}</span></td>
                            <td class="fw-semibold">{{ entry.folioNumber }}</td>
                            <td>
                                {% if entry.voucher %}
                                    <span class="text-muted small">
                                        #{{ entry.voucher.id }}
                                        ({{ entry.voucher.folioFrom }}–{{ entry.voucher.folioTo }})
                                    </span>
                                {% else %}—{% endif %}
                            </td>
                            <td>
                                {{ entry.voucher and entry.voucher.cashRegisterLocation
                                    ? entry.voucher.cashRegisterLocation.name
                                    : '—' }}
                            </td>
                            <td>{{ entry.member ? entry.member.username : '—' }}</td>
                            <td class="text-muted small">
                                {{ entry.issuedAt ? entry.issuedAt|date('d/m/Y H:i') : '—' }}
                            </td>
                            <td>
                                {% if entry.isCancelled %}
                                    <span class="badge bg-danger">Anulado</span>
                                {% else %}
                                    <span class="badge bg-success">Vigente</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if not entry.isCancelled %}
                                    <form method="POST"
                                          action="{{ path('app_revenue_supervisor_vouchers_void', {id: entry.id}) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('¿Anular el folio #{{ entry.folioNumber }}? Esta acción no se puede deshacer.')">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('void_entry_' ~ entry.id) }}">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Anular folio">
                                            <i class="bi bi-slash-circle me-1"></i>Anular
                                        </button>
                                    </form>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-muted small text-center">
                Mostrando los últimos 50 registros. Use los filtros para acotar la búsqueda.
            </div>
        </div>
    {% endif %}

</div>
{% endblock %}
