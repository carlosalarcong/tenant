{% extends 'app_layout.html.twig' %}

{% block content %}
<div class="container-fluid px-3 py-2">

    {# ── Encabezado ──────────────────────────────────────────────────────── #}
    <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
        <h4 class="mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-shield-check text-primary"></i>
            Autorización de Descuentos
        </h4>
        <span class="badge bg-primary-subtle text-primary-emphasis fs-6">
            {{ pending|length }} pendiente{{ pending|length != 1 ? 's' : '' }}
        </span>
    </div>

    {# ── Flash messages ───────────────────────────────────────────────────── #}
    {% for msg in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>{{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i>{{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# ── Tabs ─────────────────────────────────────────────────────────────── #}
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item">
            <a class="nav-link {{ activeTab == 'pending' ? 'active' : '' }}"
               href="{{ path('app_revenue_supervisor_differences_index', {tab: 'pending'}) }}">
                <i class="bi bi-hourglass-split me-1"></i>
                Pendientes
                {% if pending|length > 0 %}
                    <span class="badge bg-warning text-dark ms-1">{{ pending|length }}</span>
                {% endif %}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ activeTab == 'history' ? 'active' : '' }}"
               href="{{ path('app_revenue_supervisor_differences_index', {tab: 'history'}) }}">
                <i class="bi bi-clock-history me-1"></i>
                Historial
            </a>
        </li>
    </ul>

    {# ════════════════════════════════════════════════════════════════════════
       TAB: PENDIENTES
       La lista de pendientes vive dentro de <turbo-frame id="pending-differences">
       para que el redirect tras aprobar/rechazar la refresque sin full-reload.
    ═══════════════════════════════════════════════════════════════════════ #}
    {% if activeTab == 'pending' %}
    <turbo-frame id="pending-differences">
        {% if pending is empty %}
            <div class="card border-0 bg-light">
                <div class="card-body text-center py-5 text-muted">
                    <i class="bi bi-check-all fs-2 d-block mb-2 opacity-50"></i>
                    <p class="mb-0">No hay solicitudes de descuento pendientes.</p>
                </div>
            </div>
        {% else %}
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Cajero</th>
                                <th>Cuenta paciente</th>
                                <th>Tipo</th>
                                <th>Total cuenta</th>
                                <th>Descuento</th>
                                <th>Total c/dscto</th>
                                <th>Solicitado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for diff in pending %}
                            <tr id="diff-row-{{ diff.id }}">
                                <td><span class="text-muted small">#{{ diff.id }}</span></td>
                                <td>{{ diff.requestedByMember ? diff.requestedByMember.username : '—' }}</td>
                                <td>
                                    {% if diff.patientAccount %}
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                            #{{ diff.patientAccount.id }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>{{ diff.differenceType ? diff.differenceType.name : '—' }}</td>
                                <td class="text-end fw-semibold">
                                    ${{ diff.totalAccount|number_format(0, ',', '.') }}
                                </td>
                                <td class="text-end text-warning fw-semibold">
                                    ${{ diff.totalDiscount|number_format(0, ',', '.') }}
                                </td>
                                <td class="text-end text-success fw-semibold">
                                    ${{ diff.totalAfterDiscount|number_format(0, ',', '.') }}
                                </td>
                                <td class="text-muted small">
                                    {{ diff.requestedAt ? diff.requestedAt|date('d/m/Y H:i') : '—' }}
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        {# Botón Aprobar #}
                                        <form method="POST"
                                              action="{{ path('app_revenue_supervisor_differences_approve', {id: diff.id}) }}"
                                              data-turbo-frame="pending-differences">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('diff_approve_' ~ diff.id) }}">
                                            <button type="submit"
                                                    class="btn btn-sm btn-success"
                                                    title="Aprobar descuento"
                                                    onclick="return confirm('¿Aprobar el descuento de ${{ diff.totalDiscount|number_format(0, ',', '.') }}?')">
                                                <i class="bi bi-check-lg"></i> Aprobar
                                            </button>
                                        </form>
                                        {# Botón Rechazar #}
                                        <form method="POST"
                                              action="{{ path('app_revenue_supervisor_differences_reject', {id: diff.id}) }}"
                                              data-turbo-frame="pending-differences">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('diff_reject_' ~ diff.id) }}">
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Rechazar descuento"
                                                    onclick="return confirm('¿Rechazar la solicitud #{{ diff.id }}?')">
                                                <i class="bi bi-x-lg"></i> Rechazar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </turbo-frame>
    {% endif %}

    {# ════════════════════════════════════════════════════════════════════════
       TAB: HISTORIAL
    ═══════════════════════════════════════════════════════════════════════ #}
    {% if activeTab == 'history' %}
        {% if history is empty %}
            <div class="card border-0 bg-light">
                <div class="card-body text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                    <p class="mb-0">No hay historial de autorizaciones.</p>
                </div>
            </div>
        {% else %}
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Cajero</th>
                                <th>Tipo</th>
                                <th>Descuento</th>
                                <th>Estado</th>
                                <th>Supervisor</th>
                                <th>Resuelto</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for diff in history %}
                            <tr>
                                <td><span class="text-muted small">#{{ diff.id }}</span></td>
                                <td>{{ diff.requestedByMember ? diff.requestedByMember.username : '—' }}</td>
                                <td>{{ diff.differenceType ? diff.differenceType.name : '—' }}</td>
                                <td class="text-end fw-semibold">
                                    ${{ diff.totalDiscount|number_format(0, ',', '.') }}
                                </td>
                                <td>
                                    {% if diff.status == 'autorizada' %}
                                        <span class="badge bg-success">Autorizada</span>
                                    {% elseif diff.status == 'auto_aprobada' %}
                                        <span class="badge bg-info">Auto-aprobada</span>
                                    {% elseif diff.status == 'rechazada' %}
                                        <span class="badge bg-danger">Rechazada</span>
                                    {% elseif diff.status == 'anulada' %}
                                        <span class="badge bg-secondary">Anulada</span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark">{{ diff.status }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ diff.authorizedByMember ? diff.authorizedByMember.username : '—' }}</td>
                                <td class="text-muted small">
                                    {{ diff.authorizedAt ? diff.authorizedAt|date('d/m/Y H:i') : '—' }}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-muted small text-center">
                    Mostrando los últimos 50 registros
                </div>
            </div>
        {% endif %}
    {% endif %}

</div>
{% endblock %}
