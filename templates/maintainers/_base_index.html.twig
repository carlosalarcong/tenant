{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} - Sistema{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="bx bx-list-ul me-2"></i>{{ page_title }}
        </h1>
        {% if create_route is defined %}
            <a href="{{ path(create_route) }}" class="btn btn-primary" data-turbo="false">
                <i class="bx bx-plus me-1"></i>{{ 'maintainers.common.create'|trans({}, 'maintainers') }}
            </a>
        {% endif %}
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bx bx-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bx bx-error-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            {% if data is empty %}
                <div class="text-center py-5">
                    <i class="bx bx-inbox bx-lg text-muted mb-3" style="font-size: 4rem;"></i>
                    <h5 class="text-muted">{{ 'maintainers.common.no_records'|trans({}, 'maintainers') }}</h5>
                    <p class="text-muted mb-3">{{ 'maintainers.common.no_records_message'|trans({}, 'maintainers') }}</p>
                    {% if create_route is defined %}
                        <a href="{{ path(create_route) }}" class="btn btn-primary" data-turbo="false">
                            <i class="bx bx-plus me-1"></i>{{ 'maintainers.common.create_first'|trans({}, 'maintainers') }}
                        </a>
                    {% endif %}
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                {% for column in columns %}
                                    <th scope="col">
                                        {% if column == 'name' %}{{ 'maintainers.columns.name'|trans({}, 'maintainers') }}
                                        {% elseif column == 'code' %}{{ 'maintainers.columns.code'|trans({}, 'maintainers') }}
                                        {% elseif column == 'isActive' %}{{ 'maintainers.columns.is_active'|trans({}, 'maintainers') }}
                                        {% elseif column == 'description' %}{{ 'maintainers.columns.description'|trans({}, 'maintainers') }}
                                        {% elseif column == 'number' %}{{ 'maintainers.columns.number'|trans({}, 'maintainers') }}
                                        {% elseif column == 'educationLevel' %}{{ 'maintainers.columns.education_level'|trans({}, 'maintainers') }}
                                        {% elseif column == 'originType' %}{{ 'maintainers.columns.origin_type'|trans({}, 'maintainers') }}
                                        {% elseif column == 'religionCodeHl7' %}{{ 'maintainers.columns.religion_code_hl7'|trans({}, 'maintainers') }}
                                        {% elseif column == 'maritalStatusCodeHl7' %}{{ 'maintainers.columns.marital_status_code_hl7'|trans({}, 'maintainers') }}
                                        {% else %}{{ column|title }}
                                        {% endif %}
                                    </th>
                                {% endfor %}
                                <th scope="col" class="text-end">{{ 'maintainers.common.actions'|trans({}, 'maintainers') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in data %}
                                <tr>
                                    {% for column in columns %}
                                        <td>
                                            {% set value = attribute(item, column) %}
                                            {% if column == 'isActive' %}
                                                {% if value %}
                                                    <span class="badge bg-success">
                                                        <i class="bx bx-check me-1"></i>{{ 'maintainers.columns.active'|trans({}, 'maintainers') }}
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-secondary">
                                                        <i class="bx bx-x me-1"></i>{{ 'maintainers.columns.inactive'|trans({}, 'maintainers') }}
                                                    </span>
                                                {% endif %}
                                            {% elseif column == 'educationLevel' and value %}
                                                {{ value.name }}
                                            {% elseif column == 'originType' and value %}
                                                {{ value.name }}
                                            {% else %}
                                                {{ value ?? '-' }}
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            {% set edit_route = app.request.attributes.get('_route')|replace({'_index': '_edit'}) %}
                                            <a href="{{ path(edit_route, {'id': item.id}) }}"
                                               class="btn btn-sm btn-outline-primary"
                                               data-turbo="false"
                                               title="{{ 'maintainers.common.edit'|trans({}, 'maintainers') }}">
                                                <i class="bx bx-edit-alt"></i>
                                            </a>
                                            {% set delete_route = app.request.attributes.get('_route')|replace({'_index': '_delete'}) %}
                                            <form method="post" 
                                                  action="{{ path(delete_route, {'id': item.id}) }}" 
                                                  class="d-inline"
                                                  data-controller="confirm-delete"
                                                  data-confirm-delete-title-value="{{ 'maintainers.common.confirm_delete_title'|trans({}, 'maintainers') }}"
                                                  data-confirm-delete-text-value="{{ 'maintainers.common.confirm_delete_text'|trans({}, 'maintainers') }}"
                                                  data-confirm-delete-confirm-button-text-value="{{ 'maintainers.common.yes_delete'|trans({}, 'maintainers') }}"
                                                  data-confirm-delete-cancel-button-text-value="{{ 'maintainers.common.cancel'|trans({}, 'maintainers') }}"
                                                  data-action="submit->confirm-delete#confirm">
                                                <button type="submit" 
                                                        class="btn btn-sm btn-outline-danger" 
                                                        title="{{ 'maintainers.common.delete'|trans({}, 'maintainers') }}">
                                                    <i class="bx bx-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted">
                        {{ 'maintainers.common.total'|trans({}, 'maintainers') }}: <strong>{{ data|length }}</strong> {{ 'maintainers.common.records'|trans({}, 'maintainers') }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
