{% extends 'maintainers/modern_index.html.twig' %}

{% block title %}Permisos de Mantenedores - Sistema{% endblock %}

{% set page_title = 'Permisos de Mantenedores' %}
{% set icon = '🔐' %}
{% set breadcrumb_section = 'Administración' %}
{% set description = 'Gestiona dinámicamente qué roles tienen qué permisos sobre los mantenedores del sistema' %}
{% set create_route = 'app_maintainer_permission_create' %}
{% set edit_route = 'app_maintainer_permission_edit' %}
{% set delete_route = 'app_maintainer_permission_delete' %}
{% set export_route = 'app_maintainer_permission_export' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .role-badge-admin { background-color: #fee2e2; color: #991b1b; }
        .role-badge-manager { background-color: #dbeafe; color: #1e40af; }
        .role-badge-user { background-color: #e0e7ff; color: #3730a3; }
        .role-badge-doctor { background-color: #d1fae5; color: #065f46; }
        .role-badge-enfermera { background-color: #fce7f3; color: #831843; }
        .role-badge-recepcion { background-color: #fef3c7; color: #92400e; }
        .role-badge-finance { background-color: #ccfbf1; color: #115e59; }
        .role-badge-hr { background-color: #ede9fe; color: #5b21b6; }
        .role-badge-clinical { background-color: #ddd6fe; color: #4c1d95; }
        
        .permission-badge-wildcard { background-color: #fef3c7; color: #92400e; font-weight: 700; }
        .permission-badge-create { background-color: #d1fae5; color: #065f46; }
        .permission-badge-read { background-color: #dbeafe; color: #1e40af; }
        .permission-badge-update { background-color: #fef3c7; color: #92400e; }
        .permission-badge-delete { background-color: #fee2e2; color: #991b1b; }
        .permission-badge-export { background-color: #e0e7ff; color: #3730a3; }
        
        .badge {
            padding: 0.35rem 0.75rem;
            font-size: 0.75rem;
            font-weight: 600;
            border-radius: 0.375rem;
        }
        
        .role-separator {
            background-color: #f1f5f9;
            height: 2px;
            margin: 0.5rem 0;
        }
    </style>
{% endblock %}

{% block content %}
    {{ parent() }}
    
    {# Nota informativa #}
    <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-radius: 12px;">
        <i class="bx bx-info-circle me-2"></i>
        <strong>Información:</strong> Los cambios en permisos se aplican inmediatamente gracias al sistema de caché. 
        Los permisos wildcard (*) otorgan todos los permisos al rol. Mayor prioridad se evalúa primero.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
{% endblock %}
