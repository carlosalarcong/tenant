{% extends 'app_layout.html.twig' %}

{% block title %}Mantenedor de Prestaciones{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-4" style="background-color: #f7fafc; min-height: 100vh;">

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><i class="bx bx-home-alt"></i></li>
            <li class="breadcrumb-item"><a href="{{ path('app_maintainers_commercial_price_manager_filter') }}" class="text-decoration-none">Aranceles y Convenios</a></li>
            {% if back_url %}<li class="breadcrumb-item"><a href="{{ back_url }}" class="text-decoration-none">Honorarios y Prestaciones</a></li>{% endif %}
            <li class="breadcrumb-item active">Mantenedor de Prestaciones</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0" style="border-radius: 12px;">

        <div class="card-header border-0 py-3 px-4 d-flex justify-content-between align-items-center"
             style="background: linear-gradient(135deg, #2563eb, #1d4ed8); border-radius: 12px 12px 0 0;">
            <h5 class="mb-0 text-white fw-semibold">
                <i class="bx bx-list-check me-2"></i>Listado de Aranceles
                {% if plan %}<small class="fw-normal opacity-75 ms-2">— {{ plan.name }}</small>{% endif %}
            </h5>
            <div class="d-flex gap-2">
                {% if back_url %}<a href="{{ back_url }}" class="btn btn-sm btn-light"><i class="bx bx-arrow-back me-1"></i>Volver</a>{% endif %}
                <button type="button" class="btn btn-sm btn-success"
                        data-bs-toggle="modal" data-bs-target="#maintainerModal"
                        data-modal-url="{{ path('app_maintainers_commercial_insurance_plan_price_create') }}"
                        data-modal-title="Nuevo Arancel">
                    <i class="bx bx-plus me-1"></i>Crear
                </button>
            </div>
        </div>

        {% if plan and plan.branchPayer %}
        <div class="px-4 py-3 border-bottom" style="background-color: #f8fafc;">
            <div class="row g-0">
                <div class="col-md-3"><span class="text-muted small fw-semibold text-uppercase" style="letter-spacing:.5px">Sucursal</span><p class="mb-0 fw-semibold small">{{ plan.branchPayer.branch.name }}</p></div>
                <div class="col-md-3"><span class="text-muted small fw-semibold text-uppercase" style="letter-spacing:.5px">Tipo Financiador</span><p class="mb-0 fw-semibold small">{{ plan.branchPayer.payer.payerType.name }}</p></div>
                <div class="col-md-3"><span class="text-muted small fw-semibold text-uppercase" style="letter-spacing:.5px">Financiador</span><p class="mb-0 fw-semibold small">{{ plan.branchPayer.payer.name }}</p></div>
                <div class="col-md-3"><span class="text-muted small fw-semibold text-uppercase" style="letter-spacing:.5px">Nombre Plan</span><p class="mb-0 fw-semibold small">{{ plan.name }}</p></div>
            </div>
        </div>
        {% endif %}

        {% if aranceles is empty %}
            <div class="card-body text-center py-5">
                <i class="bx bx-inbox text-muted mb-3" style="font-size:4rem"></i>
                <h5 class="text-muted">No hay aranceles registrados</h5>
                <button type="button" class="btn btn-primary mt-2"
                        data-bs-toggle="modal" data-bs-target="#maintainerModal"
                        data-modal-url="{{ path('app_maintainers_commercial_insurance_plan_price_create') }}"
                        data-modal-title="Nuevo Arancel">
                    <i class="bx bx-plus me-1"></i>Crear primer arancel
                </button>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color:#f8fafc; border-bottom:2px solid #e2e8f0;">
                        <tr>
                            <th class="text-uppercase text-muted fw-bold px-4" style="font-size:.75rem;letter-spacing:.5px;padding:1rem">Fecha Vigencia</th>
                            <th class="text-uppercase text-muted fw-bold" style="font-size:.75rem;letter-spacing:.5px;padding:1rem;width:160px">Estado</th>
                            <th class="text-end px-4" style="padding:1rem;width:130px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for arancel in aranceles %}
                        <tr {% if arancel.status == 'NO VIGENTE' %}style="background-color:#fff5f5"{% endif %}>
                            <td class="px-4 py-3 fw-semibold" style="color:#1e293b">{{ arancel.fv ? arancel.fv|date('d-m-Y') : '—' }}</td>
                            <td class="py-3">
                                {% if arancel.status == 'VIGENTE' %}
                                    <span class="badge text-white fw-semibold px-3 py-2" style="background-color:#2563eb;border-radius:6px">VIGENTE</span>
                                {% elseif arancel.status == 'FUTURO' %}
                                    <span class="badge text-white fw-semibold px-3 py-2" style="background-color:#d97706;border-radius:6px">FUTURO</span>
                                {% else %}
                                    <span class="badge text-white fw-semibold px-3 py-2" style="background-color:#dc2626;border-radius:6px">NO VIGENTE</span>
                                {% endif %}
                            </td>
                            <td class="text-end px-4 py-3">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a href="#" class="btn btn-sm btn-primary" title="Ver Arancel"><i class="bx bx-show"></i></a>
                                    <a href="#" class="btn btn-sm btn-warning text-white" title="Editar Arancel"><i class="bx bx-edit"></i></a>
                                    <a href="#" class="btn btn-sm btn-success" title="Exportar"><i class="bx bx-download"></i></a>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer border-top py-3 px-4" style="background-color:#f8fafc;border-radius:0 0 12px 12px">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Mostrando {{ aranceles|length }} registro{% if aranceles|length != 1 %}s{% endif %}</small>
                    {% if back_url %}<a href="{{ back_url }}" class="btn btn-sm btn-outline-secondary"><i class="bx bx-arrow-back me-1"></i>Volver</a>{% endif %}
                </div>
            </div>
        {% endif %}
    </div>

    {% include 'components/_modal_base.html.twig' with {
        'modal_id': 'maintainerModal', 'modal_title': 'Arancel',
        'frame_id': 'maintainer-form', 'modal_size': 'xl', 'loading_text': 'Cargando...'
    } %}

</div>
{% endblock %}
