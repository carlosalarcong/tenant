{% extends 'app_layout.html.twig' %}

{% block title %}Planes de Paquete Integral - Sistema{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><i class="bx bx-home-alt"></i></li>
            <li class="breadcrumb-item text-muted">Mantenedores</li>
            <li class="breadcrumb-item text-muted">Comercial</li>
            <li class="breadcrumb-item active" aria-current="page">Planes de Paquete Integral</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-1">Planes de Paquete Integral</h1>
                <p class="text-muted mb-0">Gestiona planes paquetizados por sucursal y financiador.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_maintainers_commercial_surgery_package_plan_export') }}" class="btn btn-outline-secondary" data-turbo="false">
                    <i class="bx bx-download me-1"></i>Exportar
                </a>
                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#maintainerModal"
                        data-modal-url="{{ path('app_maintainers_commercial_surgery_package_plan_create') }}"
                        data-modal-title="<i class='bx bx-plus me-2'></i>Nuevo plan">
                    <i class="bx bx-plus me-1"></i>Nuevo registro
                </button>
            </div>
        </div>
    </div>

    <div id="flash-messages">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    </div>

    <div class="card shadow-sm border-0">
        {% if data is empty %}
            <div class="card-body text-center py-5 text-muted">
                No hay planes registrados.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Plan</th>
                            <th>Sucursal</th>
                            <th>Financiador</th>
                            <th>Creado</th>
                            <th>Activo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for plan in data %}
                            <tr>
                                <td>{{ plan.id }}</td>
                                <td>{{ plan.name }}</td>
                                <td>{{ plan.branchPayer.branch.name }}</td>
                                <td>{{ plan.branchPayer.payer.name }}</td>
                                <td>{{ plan.createdAt ? plan.createdAt|date('d/m/Y H:i') : '-' }}</td>
                                <td>
                                    {% if plan.isActive %}
                                        <span class="badge text-bg-success">Activo</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">Inactivo</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a href="{{ path('app_maintainers_commercial_surgery_package_index', {planId: plan.id}) }}" class="btn btn-sm btn-outline-info">
                                            <i class="bx bx-box me-1"></i>Paquetes
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#maintainerModal"
                                                data-modal-url="{{ path('app_maintainers_commercial_surgery_package_plan_edit', {id: plan.id}) }}"
                                                data-modal-title="<i class='bx bx-edit me-2'></i>Editar plan">
                                            <i class="bx bx-edit-alt"></i>
                                        </button>
                                        <form method="post" action="{{ path('app_maintainers_commercial_surgery_package_plan_delete', {id: plan.id}) }}" class="d-inline">
                                            <input type="hidden" name="_method" value="DELETE">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bx bx-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {% include 'components/_modal_base.html.twig' with {
        'modal_id': 'maintainerModal',
        'modal_title': 'Planes de Paquete Integral',
        'frame_id': 'maintainer-form',
        'modal_size': 'lg',
        'loading_text': 'Cargando...'
    } %}
</div>
{% endblock %}
