{% extends 'maintainers/modern_index.html.twig' %}

{% block page_title %}Tipos de Método de Pago{% endblock %}
{% block icon %}fa-credit-card{% endblock %}
{% block breadcrumb_section %}Tesorería{% endblock %}
{% block description %}Gestión de tipos de métodos de pago{% endblock %}

{% block maintainer_routes %}
    {% set index_route = 'app_maintainers_treasury_payment_method_type_index' %}
    {% set create_route = 'app_maintainers_treasury_payment_method_type_create' %}
    {% set edit_route = 'app_maintainers_treasury_payment_method_type_edit' %}
    {% set delete_route = 'app_maintainers_treasury_payment_method_type_delete' %}
    {% set export_route = 'app_maintainers_treasury_payment_method_type_export' %}
{% endblock %}

{% block table_headers %}
    <th>ID</th>
    <th>Nombre</th>
    <th>Estado</th>
    <th>{{ 'maintainers.common.actions'|trans({}, 'maintainers') }}</th>
{% endblock %}

{% block table_row %}
    <td>{{ item.id }}</td>
    <td>{{ item.name }}</td>
    <td>
        {% if item.isActive %}
            <span class="badge bg-success">Activo</span>
        {% else %}
            <span class="badge bg-danger">Inactivo</span>
        {% endif %}
    </td>
    <td>
        <button class="btn btn-sm btn-primary" onclick="editItem({{ item.id }})">
            <i class="fas fa-edit"></i>
        </button>
        <button class="btn btn-sm btn-danger" onclick="deleteItem({{ item.id }})">
            <i class="fas fa-trash"></i>
        </button>
    </td>
{% endblock %}
