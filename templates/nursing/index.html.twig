{% extends 'app_layout.html.twig' %}

{% block title %}Enfermería - Sistema{% endblock %}

{% block content %}
    <div class="container-fluid px-4 py-4" data-controller="nursing--board">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <div>
                <h1 class="mb-1">Enfermería</h1>
                <p class="text-muted mb-0">Tablero de camas y estado general por servicio</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-3">
                {% include 'nursing/service/_selector.html.twig' with {
                    services: services,
                    selected_service_id: selected_service_id,
                    available_beds_by_service: available_beds_by_service
                } %}
            </div>

            <div class="col-12 col-xl-9">
                {% if selected_service and selected_service_id %}
                    {% include 'nursing/service/_board.html.twig' with {
                        service: selected_service,
                        rooms_with_beds: rooms_with_beds,
                        admissions_by_bed: admissions_by_bed,
                        pending_requests: pending_requests
                    } %}
                {% else %}
                    <turbo-frame id="nursing-board" data-nursing--board-target="board">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body text-center py-5">
                                <i class="bx bx-clinic text-primary fs-2 d-block mb-2"></i>
                                <h5 class="mb-1">Selecciona un servicio</h5>
                                <p class="text-muted mb-0">El tablero de camas se mostrará aquí.</p>
                            </div>
                        </div>
                    </turbo-frame>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
