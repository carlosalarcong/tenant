<turbo-frame id="nursing-patient-tab">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Devoluciones</h6>
            <a href="{{ path('app_nursing_patient_return_create', { id: admission_record.id }) }}" class="btn btn-sm btn-primary" data-turbo-frame="nursing-patient-tab">Nueva devolución</a>
        </div>
        <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Fecha</th><th>Item</th><th>Cantidad</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
            {% for r in returns %}
                <tr>
                    <td>{{ r.createdAt|date('d-m-Y H:i') }}</td><td>{{ r.itemName }}</td><td>{{ r.quantity }}</td><td>{{ r.status }}</td>
                    <td>{% if r.status == 'active' %}<form method="post" action="{{ path('app_nursing_patient_return_cancel', { id: admission_record.id, rid: r.id }) }}"><input type="hidden" name="_token" value="{{ csrf_token('nursing_return_cancel') }}"><button class="btn btn-sm btn-outline-danger">Anular</button></form>{% endif %}</td>
                </tr>
            {% else %}<tr><td colspan="5" class="text-muted text-center">Sin devoluciones</td></tr>{% endfor %}
        </tbody></table></div>
    </div>
</turbo-frame>
