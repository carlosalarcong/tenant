{% extends 'app_layout.html.twig' %}
{% block title %}Egresos por alta{% endblock %}
{% block content %}
<div class="container-fluid px-4 py-4"><h1>Egresos por alta</h1>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>ID</th><th>Admisión</th><th>Tipo</th><th>Condición</th><th>Fecha</th></tr></thead><tbody>
{% for r in requests %}<tr><td>#{{ r.id }}</td><td>#{{ r.admissionRecord.id }}</td><td>{{ r.dischargeType }}</td><td>{{ r.conditionStatus }}</td><td>{{ r.dischargedAt|date('d-m-Y H:i') }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted">Sin egresos</td></tr>{% endfor %}
</tbody></table></div></div></div>
{% endblock %}
