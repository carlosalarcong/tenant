{% extends 'app_layout.html.twig' %}
{% block title %}Solicitudes de admisión{% endblock %}
{% block content %}
<div class="container-fluid px-4 py-4">
<h1>Solicitudes de admisión</h1>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Admisión</th><th>Paciente</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
{% for r in requests %}
<tr>
<td>#{{ r.id }}</td><td>{{ r.person ? r.person.name ~ ' ' ~ r.person.lastName : '-' }}</td><td>{{ r.status }}</td>
<td>
<form method="post" action="{{ path('app_nursing_request_admit', { admissionId: r.id }) }}" class="d-flex gap-2">
<input type="hidden" name="_token" value="{{ csrf_token('nursing_request_admit') }}">
<input type="hidden" name="serviceId" value="{{ service_id }}">
<input type="number" name="bedId" class="form-control form-control-sm" placeholder="ID cama" min="1" required>
<button class="btn btn-sm btn-primary">Ingresar</button>
</form>
</td>
</tr>
{% else %}<tr><td colspan="4" class="text-center text-muted">Sin solicitudes</td></tr>{% endfor %}
</tbody></table></div></div>
</div>
{% endblock %}
