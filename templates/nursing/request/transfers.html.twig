{% extends 'app_layout.html.twig' %}
{% block title %}Solicitudes de traslado{% endblock %}
{% block content %}
<div class="container-fluid px-4 py-4"><h1>Solicitudes de traslado</h1>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>ID</th><th>Admisión</th><th>Origen</th><th>Destino</th><th>Estado</th></tr></thead><tbody>
{% for r in requests %}<tr><td>#{{ r.id }}</td><td>#{{ r.admissionRecord.id }}</td><td>{{ r.originService.name }}</td><td>{{ r.destinationService.name }}</td><td>{{ r.status }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted">Sin solicitudes</td></tr>{% endfor %}
</tbody></table></div></div></div>
{% endblock %}
