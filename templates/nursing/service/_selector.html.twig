<div class="card border-0 shadow-sm" data-controller="nursing--service-filter">
    <div class="card-header bg-white pb-2">
        <h5 class="mb-2">Servicios</h5>
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-white border-end-0">
                <i class="bx bx-search text-muted"></i>
            </span>
            <input type="text"
                   class="form-control border-start-0 ps-0"
                   placeholder="Buscar servicio..."
                   data-nursing--service-filter-target="input"
                   data-action="input->nursing--service-filter#filter">
            <button class="btn btn-outline-secondary border-start-0"
                    type="button"
                    data-action="click->nursing--service-filter#clear"
                    tabindex="-1">
                <i class="bx bx-x"></i>
            </button>
        </div>
    </div>

    <div class="card-body p-2" style="max-height: 70vh; overflow-y: auto;">
        {% for service in services %}
            <a href="{{ path('app_nursing_service_board', { serviceId: service.id }) }}"
               class="card mb-2 text-decoration-none nur-service-card{% if selected_service_id == service.id %} active{% endif %}"
               data-turbo-frame="nursing-board"
               data-action="click->nursing--board#selectService"
               data-nursing--board-target="serviceCard"
               data-nursing--service-filter-target="card"
               data-service-name="{{ service.name }}">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bx bx-plus-medical fs-5 text-primary"></i>
                            <div>
                                <div class="fw-semibold text-dark">{{ service.name }}</div>
                                <div class="small text-muted">ID #{{ service.id }}</div>
                            </div>
                        </div>
                        <span class="badge rounded-pill text-bg-light">
                            {{ available_beds_by_service[service.id]|default(0) }} libres
                        </span>
                    </div>
                </div>
            </a>
        {% endfor %}

        <p class="text-muted small mb-0 p-2"
           style="display: none"
           data-nursing--service-filter-target="empty">
            Sin resultados.
        </p>

        {% if services is empty %}
            <p class="text-muted small mb-0 p-2">No hay servicios activos.</p>
        {% endif %}
    </div>
</div>
