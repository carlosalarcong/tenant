<turbo-frame id="patient-budgets">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-0">{{ person.firstName }} {{ person.lastName }}</h5>
            <small class="text-muted">{{ person.rut }}</small>
        </div>
        <a href="{{ path('app_budget_new', {personId: person.id}) }}"
           class="btn btn-success btn-sm" data-turbo="false">
            <i class="bi bi-plus-lg"></i> Nuevo Presupuesto
        </a>
    </div>

    {% if budgets is empty %}
        <p class="text-muted small">Sin presupuestos para este paciente.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Fecha</th>
                        <th>Modalidad</th>
                        <th>Plan</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for b in budgets %}
                        <tr>
                            <td class="fw-bold">{{ b.number }}</td>
                            <td>{{ b.createdAt|date('d/m/Y') }}</td>
                            <td>{{ b.insurancePlan ? 'Abierta' : 'Paquetizado' }}</td>
                            <td class="small">
                                {{ b.insurancePlan ? b.insurancePlan.name
                                    : (b.surgeryPackagePlan ? b.surgeryPackagePlan.name : '—') }}
                            </td>
                            <td>
                                <span class="badge bg-{{ b.status == 'active' ? 'success' : 'secondary' }}">
                                    {{ b.status }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_budget_show', {id: b.id}) }}"
                                   class="btn btn-sm btn-outline-primary" data-turbo="false">Ver</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</turbo-frame>
