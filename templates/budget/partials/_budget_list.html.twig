<turbo-frame id="budget-list" class="d-block">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h3 class="h5 mb-0">Presupuestos de {{ person.name }} {{ person.lastName }}</h3>
        </div>
        <div class="card-body p-0">
            {% if budgets is not empty %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>N°</th>
                                <th>Fecha</th>
                                <th>Financiador</th>
                                <th>Plan</th>
                                <th>Profesional</th>
                                <th>Estado</th>
                                <th>Vigencia</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for budget in budgets %}
                                {% set isCurrent = budget.expiresAt is null or budget.expiresAt >= today %}
                                <tr>
                                    <td class="fw-semibold">{{ budget.number }}</td>
                                    <td>{{ budget.createdAt ? budget.createdAt|date('d/m/Y H:i') : '-' }}</td>
                                    <td>{{ budget.payer ? budget.payer.name : (budget.agreement ? budget.agreement.payer.name : '-') }}</td>
                                    <td>
                                        {% if budget.insurancePlan %}
                                            {{ budget.insurancePlan.name }}
                                        {% elseif budget.surgeryPackagePlan %}
                                            {{ budget.surgeryPackagePlan.name }} <span class="badge bg-secondary">Paquetizado</span>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ budget.professional ? budget.professional.fullName : '-' }}</td>
                                    <td>
                                        <span class="badge text-bg-secondary">{{ budget.status|default('active') }}</span>
                                    </td>
                                    <td>
                                        {% if isCurrent %}
                                            <span class="badge text-bg-success">Vigente</span>
                                        {% else %}
                                            <span class="badge text-bg-danger">Vencido</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="{{ path('budget_show', {id: budget.id}) }}"
                                               class="btn btn-outline-primary"
                                               data-turbo-frame="_top">Ver detalle</a>
                                            <a href="{{ path('budget_pdf', {id: budget.id}) }}"
                                               class="btn btn-outline-secondary"
                                               data-turbo-frame="_top">Ver PDF</a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="p-4 text-center text-muted">
                    No hay presupuestos registrados
                </div>
            {% endif %}
        </div>
    </div>
</turbo-frame>
