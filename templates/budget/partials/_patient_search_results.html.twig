<turbo-frame id="patient-result" class="d-block">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h3 class="h5 mb-0">Resultados de búsqueda</h3>
        </div>
        <div class="card-body p-0">
            {% if people is empty %}
                <div class="p-4 text-center text-muted">
                    {{ message ?: 'Paciente no encontrado' }}
                </div>
            {% else %}
                <div class="list-group list-group-flush">
                    {% for person in people %}
                        <div class="list-group-item d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                            <div>
                                <div class="fw-semibold">
                                    {{ person.name }}
                                    {% if person.middleName %} {{ person.middleName }}{% endif %}
                                    {{ person.lastName }}
                                </div>
                                <div class="text-muted small">{{ person.identification }}</div>
                            </div>
                            <a href="{{ path('budget_patient_select', {personId: person.id}) }}"
                               class="btn btn-outline-primary btn-sm"
                               data-turbo-frame="patient-result">
                                Seleccionar
                            </a>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</turbo-frame>
