<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body        { font-family: Arial, sans-serif; font-size: 11px; color: #333; }
        h1          { font-size: 16px; margin-bottom: 4px; }
        .subtitle   { color: #666; font-size: 10px; margin-bottom: 16px; }
        table       { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
        th          { background: #f0f0f0; text-align: left; padding: 4px 6px;
                      border-bottom: 2px solid #ccc; font-size: 10px; text-transform: uppercase; }
        td          { padding: 3px 6px; border-bottom: 1px solid #eee; }
        .text-right { text-align: right; }
        .total-row  { font-weight: bold; background: #f8f8f8; }
        .grand-total { font-size: 13px; font-weight: bold; text-align: right;
                       margin-top: 8px; border-top: 2px solid #333; padding-top: 6px; }
        .footer     { margin-top: 20px; font-size: 9px; color: #666;
                      border-top: 1px solid #ccc; padding-top: 8px; }
        .info-grid  { display: table; width: 100%; margin-bottom: 16px; }
        .info-row   { display: table-row; }
        .info-label { display: table-cell; font-weight: bold; width: 120px;
                      padding: 2px 0; color: #555; }
        .info-value { display: table-cell; padding: 2px 0; }
    </style>
</head>
<body>

    <h1>Presupuesto N° {{ budget.number }}</h1>
    <p class="subtitle">
        Fecha: {{ budget.createdAt|date('d/m/Y') }}
        {% if budget.expiresAt %} — Vigencia: {{ budget.expiresAt|date('d/m/Y') }}{% endif %}
    </p>

    <div class="info-grid">
        <div class="info-row">
            <span class="info-label">Paciente:</span>
            <span class="info-value">
                {{ budget.person.firstName }} {{ budget.person.lastName }}
                ({{ budget.person.rut }})
            </span>
        </div>
        <div class="info-row">
            <span class="info-label">Modalidad:</span>
            <span class="info-value">{{ budget.insurancePlan ? 'Cuenta Abierta' : 'Paquetizado' }}</span>
        </div>
        {% if budget.insurancePlan %}
        <div class="info-row">
            <span class="info-label">Plan:</span>
            <span class="info-value">{{ budget.insurancePlan.name }}</span>
        </div>
        {% endif %}
        {% if budget.payer %}
        <div class="info-row">
            <span class="info-label">Financiador:</span>
            <span class="info-value">{{ budget.payer.name }}</span>
        </div>
        {% endif %}
        {% if budget.agreement %}
        <div class="info-row">
            <span class="info-label">Convenio:</span>
            <span class="info-value">{{ budget.agreement.name }}</span>
        </div>
        {% endif %}
        {% if budget.professional %}
        <div class="info-row">
            <span class="info-label">Profesional:</span>
            <span class="info-value">
                {{ budget.professional.lastName }}, {{ budget.professional.firstName }}
            </span>
        </div>
        {% endif %}
    </div>

    {% set itemTypeLabels = {
        'honorario':      'Honorarios',
        'pabellon':       'Pabellón',
        'clinico':        'Clínico',
        'valorizable':    'Valorizable',
        'examen':         'Exámenes',
        'dia_cama':       'Días Cama',
        'clinico_manual': 'Clínico Manual'
    } %}

    {% for type, details in detailsByType %}
    <table>
        <thead>
            <tr>
                <th>{{ itemTypeLabels[type] ?? type }}</th>
                <th class="text-right">Monto</th>
            </tr>
        </thead>
        <tbody>
            {% for d in details %}
            <tr>
                <td>
                    {{ d.medicalService ? d.medicalService.name
                        : (d.surgeryPackageItem ? d.surgeryPackageItem.name : '—') }}
                </td>
                <td class="text-right">$ {{ d.amount|number_format(0, ',', '.') }}</td>
            </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr class="total-row">
                <td>Subtotal</td>
                <td class="text-right">$ {{ totalsByType[type]|number_format(0, ',', '.') }}</td>
            </tr>
        </tfoot>
    </table>
    {% endfor %}

    <p class="grand-total">TOTAL: $ {{ grandTotal|number_format(0, ',', '.') }}</p>

    {% if footerText %}
        <div class="footer">{{ footerText }}</div>
    {% endif %}

</body>
</html>
