{% extends 'app_layout.html.twig' %}

{% block title %}Presupuesto {{ budget.number }}{% endblock %}

{% block content %}
    <div class="container-fluid py-4">
        <div id="flash-messages">
            {{ include('components/_flash_messages.html.twig') }}
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <h1 class="h3 mb-1">Presupuesto N° {{ budget.number }}</h1>
                    <div class="text-muted">Creado el {{ budget.createdAt ? budget.createdAt|date('d/m/Y H:i') : '-' }}</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('budget_pdf', {id: budget.id}) }}" class="btn btn-outline-primary" data-turbo-frame="_top">Imprimir PDF</a>
                    <a href="{{ path('budget_pdf_summary', {id: budget.id}) }}" class="btn btn-outline-secondary" data-turbo-frame="_top">PDF Resumido</a>
                    <form method="post" action="{{ path('budget_send_email', {id: budget.id}) }}">
                        <button class="btn btn-success">Enviar Email</button>
                    </form>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4"><strong>Paciente:</strong> {{ budget.person ? budget.person.name ~ ' ' ~ (budget.person.middleName ?: '') ~ ' ' ~ budget.person.lastName : '-' }}</div>
                    <div class="col-md-4"><strong>Financiador:</strong> {{ budget.payer ? budget.payer.name : (budget.agreement and budget.agreement.payer ? budget.agreement.payer.name : '-') }}</div>
                    <div class="col-md-4"><strong>Convenio:</strong> {{ budget.agreement ? budget.agreement.name : '-' }}</div>
                    <div class="col-md-4">
                        <strong>Plan:</strong>
                        {% if budget.insurancePlan %}
                            {{ budget.insurancePlan.name }}
                        {% elseif budget.surgeryPackagePlan %}
                            {{ budget.surgeryPackagePlan.name }} <span class="badge bg-secondary">Paquetizado</span>
                        {% else %}
                            -
                        {% endif %}
                    </div>
                    <div class="col-md-4"><strong>Profesional:</strong> {{ budget.professional ? budget.professional.fullName : '-' }}</div>
                    <div class="col-md-4"><strong>Tipo atención:</strong> {{ budget.careType ? budget.careType.name : '-' }}</div>
                    <div class="col-md-4"><strong>Origen:</strong> {{ budget.origin ? budget.origin.name : '-' }}</div>
                    <div class="col-md-4">
                        <strong>Vigencia:</strong>
                        {% if isExpired %}
                            <span class="badge text-bg-danger">Vencido</span>
                        {% else %}
                            <span class="badge text-bg-success">Vigente</span>
                        {% endif %}
                        {% if budget.expiresAt %}
                            <span class="text-muted ms-1">{{ budget.expiresAt|date('d/m/Y') }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% set sections = {
            'honorarios': 'Honorarios',
            'pabellon': 'Pabellón',
            'clinicos': 'Ítems clínicos',
            'valorizables': 'Valorizables',
            'examenes': 'Exámenes',
            'diaCama': 'Día cama'
        } %}

        {% for key, title in sections %}
            {% if groupedDetails[key] is not empty %}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h2 class="h5 mb-0">{{ title }}</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ítem</th>
                                    <th>Tipo</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for detail in groupedDetails[key] %}
                                    <tr>
                                        <td>{{ detail.medicalService ? detail.medicalService.name : (detail.surgeryPackageItem ? detail.surgeryPackageItem.name : '-') }}</td>
                                        <td>{{ detail.itemType|replace({'_': ' '})|title }}</td>
                                        <td class="text-end">{{ detail.quantity }}</td>
                                        <td class="text-end">{{ detail.amount|number_format(0, ',', '.') }}</td>
                                    </tr>
                                {% endfor %}
                                <tr class="table-light">
                                    <td colspan="3" class="text-end fw-semibold">Subtotal {{ title }}</td>
                                    <td class="text-end fw-semibold">{{ totals[key]|number_format(0, ',', '.') }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}
        {% endfor %}

        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <span class="fw-semibold">TOTAL GENERAL</span>
                <span class="h4 mb-0">{{ totals.general|number_format(0, ',', '.') }}</span>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Pie de presupuesto</h2>
            </div>
            <div class="card-body text-muted">
                {{ budget.footerText ?: 'Sin pie de presupuesto configurado.' }}
            </div>
        </div>

        <turbo-frame id="budget-observations" src="{{ path('budget_observations', {id: budget.id}) }}">
            <div class="card shadow-sm">
                <div class="card-body text-muted">Cargando observaciones...</div>
            </div>
        </turbo-frame>
    </div>
{% endblock %}
