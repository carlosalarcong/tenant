<aside class="sidebar" id="sidebar" data-controller="sidebar" style="display: flex; flex-direction: column; height: 100vh; overflow: hidden;">
    <div class="sidebar-header">
        <div class="clinic-logo">
            <i class="fas fa-clinic-medical fa-2x" style="color: white;"></i>
        </div>
        <h5 class="clinic-name">Sistema Health</h5>
        <small class="clinic-subdomain">{{ tenant_info.subdomain|default('sistema') }}</small>
    </div>
    
    <!-- Contenedor con scroll para el contenido del sidebar -->
    <div style="flex: 1; overflow-y: auto; overflow-x: hidden; padding-bottom: 60px;" class="sidebar-scrollable">
    
    <div class="sidebar-heading">
        <span>Principal</span>
    </div>
    <ul class="nav flex-column">
        {# Lazy loading: Cargar menú DESPUÉS de que tenant esté establecido #}
        {% set menu_items = get_menu() %}
        {% for item in menu_items %}
            {{ _self.render_menu_item(item, 1, loop.index) }}
        {% endfor %}
    </ul>
    
    </div> <!-- Cierre del contenedor con scroll -->
</aside>

{# Macro recursiva para renderizar items de menú en cualquier nivel #}
{% macro render_menu_item(item, level, key_prefix) %}
    {# Iconos por defecto si no viene especificado en el item #}
    {% set icon_by_level = {
        1: 'bx bx-home-circle',
        2: 'bx bx-folder',
        3: 'bx bx-chevron-right',
        4: 'bx bx-circle',
        5: 'bx bx-dot-circle-o'
    } %}
    
    {# CORRECCIÓN: Determinar el icono explícitamente #}
    {% set item_icon = item.icon is defined and item.icon ? item.icon : icon_by_level[level] %}
    
    {% if item.children is empty %}
        {# Item final sin hijos #}
        <li class="nav-item">
            <a class="nav-link nav-level-{{ level }} {% if item.is_active|default(false) %}active{% endif %}" 
               href="{{ (item.route is defined and item.route) ? path(item.route) : '#' }}"
               {% if item.module|default(false) and (
                   'maintenance_' in item.module or
                   item.module == 'admission' or
                   item.module == 'maintenance_admission' or
                   item.module == 'nursing'
               ) %}
                   data-turbo-frame="maintainer-content"
                   data-turbo-action="advance"
               {% endif %}
               title="{{ item.label }}">
                <i class="{{ item_icon }}"></i>
                <span class="nav-link-text">{{ item.label }}</span>
            </a>
        </li>
    {% else %}
        {# Item con hijos (colapsable) #}
        {% set shouldExpand = item.should_expand|default(false) %}
        {% set collapse_id = 'sidebarItem' ~ key_prefix %}
        
        <li class="nav-item">
            <a class="nav-link menu-link nav-level-{{ level }} {% if not shouldExpand %}collapsed{% endif %}"
               href="javascript:void(0)"
               role="button"
               aria-expanded="{{ shouldExpand ? 'true' : 'false' }}"
               aria-controls="{{ collapse_id }}"
               data-bs-toggle="collapse"
               data-sidebar-target="{{ collapse_id }}"
               data-action="click->sidebar#toggleCollapse"
               title="{{ item.label }}">
                <i class="{{ item_icon }}"></i>
                <span class="nav-link-text">{{ item.label }}</span>
            </a>
            
            {# Submenú colapsable recursivo #}
            <div class="collapse menu-dropdown menu-level-{{ level + 1 }} {% if shouldExpand %}show{% endif %}" 
                 id="{{ collapse_id }}">
                <ul class="nav nav-sm flex-column">
                    {% for child in item.children %}
                        {{ _self.render_menu_item(child, level + 1, key_prefix ~ '-' ~ loop.index) }}
                    {% endfor %}
                </ul>
            </div>
        </li>
    {% endif %}
{% endmacro %}
