<!-- Scripts específicos del dashboard -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Animaciones suaves para las tarjetas
    const cards = document.querySelectorAll('.card');
    cards.forEach((card, index) => {
        card.style.animationDelay = `${index * 0.1}s`;
        card.classList.add('fade-in');
    });
    
    // Actualizar la hora cada minuto
    setInterval(function() {
        const now = new Date();
        const timeElements = document.querySelectorAll('.current-time');
        timeElements.forEach(el => {
            el.textContent = now.toLocaleTimeString('es-CL');
        });
    }, 60000);
    
    // Tooltip para botones
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
    tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
    
    console.log('Dashboard cargado para:', '{{ tenant.name|default("Clínica") }}');
    console.log('Usuario:', '{{ logged_user.username|default("Usuario") }}');
    
    // Manejo del menú desplegable de Mantenedores
    const maintainersSubmenu = document.getElementById('maintainersSubmenu');
    const maintainersChevron = document.getElementById('maintainersChevron');
    
    if (maintainersSubmenu && maintainersChevron) {
        // Restaurar estado del menú desde localStorage
        const isExpanded = localStorage.getItem('maintainersMenuExpanded') === 'true';
        if (isExpanded) {
            maintainersSubmenu.classList.add('show');
            maintainersChevron.style.transform = 'rotate(180deg)';
        }
        
        // Toggle del chevron cuando se expande/colapsa
        maintainersSubmenu.addEventListener('show.bs.collapse', function () {
            maintainersChevron.style.transform = 'rotate(180deg)';
            localStorage.setItem('maintainersMenuExpanded', 'true');
        });
        
        maintainersSubmenu.addEventListener('hide.bs.collapse', function () {
            maintainersChevron.style.transform = 'rotate(0deg)';
            localStorage.setItem('maintainersMenuExpanded', 'false');
        });
    }
});
</script>

<style>
/* Estilos para el menú desplegable de Mantenedores */
.transition-transform {
    transition: transform 0.3s ease;
}

/* Hover effect para items del submenú */
#maintainersSubmenu .nav-link {
    transition: all 0.2s ease;
    border-radius: 0.25rem;
}

#maintainersSubmenu .nav-link:hover {
    background-color: rgba(13, 110, 253, 0.1);
    padding-left: 1.5rem !important;
    color: #0d6efd;
}

/* Estilos para categorías */
#maintainersSubmenu small.text-muted {
    position: sticky;
    top: 0;
    background-color: #f8f9fa;
    z-index: 10;
    padding-top: 0.5rem;
    padding-bottom: 0.25rem;
}

/* Animación suave del collapse */
#maintainersSubmenu.collapsing {
    transition: height 0.35s ease;
}

/* Scrollbar personalizado para el submenú */
#maintainersSubmenu ul::-webkit-scrollbar {
    width: 6px;
}

#maintainersSubmenu ul::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
}

#maintainersSubmenu ul::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 10px;
}

#maintainersSubmenu ul::-webkit-scrollbar-thumb:hover {
    background: #555;
}

/* Destacar item activo */
#maintainersSubmenu .nav-link.active {
    background-color: #0d6efd;
    color: white !important;
}

/* Ajuste de padding para mejor jerarquía visual */
#maintainersSubmenu .nav-item .nav-link {
    padding-left: 1rem;
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
    font-size: 0.875rem;
}

/* Icono del chevron con mejor indicación visual */
.nav-link[data-bs-toggle="collapse"] .fa-chevron-down {
    opacity: 0.6;
}

.nav-link[data-bs-toggle="collapse"]:hover .fa-chevron-down {
    opacity: 1;
}
</style>
{% endblock %}